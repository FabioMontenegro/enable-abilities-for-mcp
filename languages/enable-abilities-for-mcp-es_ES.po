#: includes/abilities.php:4958 includes/abilities.php:5370
msgid "The custom post type slug."
msgstr "El slug del tipo de contenido personalizado."

#: includes/abilities.php:4962
msgid "The item title."
msgstr "El título del elemento."

#: includes/abilities.php:4966
msgid ""
"The item content (optional — some CPTs store data in meta fields instead)."
msgstr ""
"El contenido del elemento (opcional: algunos CPT almacenan datos en campos "
"meta)."

#: includes/abilities.php:4970
msgid "The item excerpt."
msgstr "El extracto del elemento."

#: includes/abilities.php:4974
msgid "Post status: draft, publish, pending, private (default draft)."
msgstr ""
"Estado de la entrada: draft, publish, pending, private (por defecto draft)."

#: includes/abilities.php:4978
msgid "Attachment ID for the featured image."
msgstr "ID del adjunto para la imagen destacada."

#: includes/abilities.php:4982
msgid "Parent item ID (for hierarchical CPTs)."
msgstr "ID del elemento padre (para CPT jerárquicos)."

#: includes/abilities.php:4986
msgid "Menu order value."
msgstr "Valor del orden del menú."

#: includes/abilities.php:4990
msgid "Author user ID."
msgstr "ID del usuario autor."

#: includes/abilities.php:4994
msgid "The URL slug for the item."
msgstr "El slug de la URL para el elemento."

#: includes/abilities.php:4998
msgid ""
"Object mapping taxonomy slugs to arrays of term slugs or IDs. Example: "
"{\"product_cat\": [\"clothing\"], \"product_tag\": [\"sale\"]}."
msgstr ""
"Objeto que mapea slugs de taxonomía a arrays de slugs o IDs de términos. "
"Ejemplo: {\"product_cat\": [\"clothing\"], \"product_tag\": [\"sale\"]}."

#: includes/abilities.php:5002 includes/abilities.php:5159
msgid ""
"Object mapping meta keys to values. Supports plugin meta like _price, _sku, "
"ACF fields, etc."
msgstr ""
"Objeto que mapea claves meta a valores. Admite meta de plugins como _price, "
"_sku, campos de ACF, etc."

#: includes/abilities.php:5026
msgid "You do not have permission to create items of this type."
msgstr "No tienes permiso para crear elementos de este tipo."

#. translators: %s: post type label
#: includes/abilities.php:5098
#, php-format
msgid "%s created successfully."
msgstr "%s creado correctamente."

#: includes/abilities.php:5119
msgid ""
"Updates an existing custom post type item. Only provided fields are modified "
"(partial update)."
msgstr ""
"Actualiza un elemento de tipo de contenido personalizado existente. Solo se "
"modifican los campos proporcionados (actualización parcial)."

#: includes/abilities.php:5127
msgid "The ID of the item to update."
msgstr "El ID del elemento a actualizar."

#: includes/abilities.php:5131
msgid "New title."
msgstr "Nuevo título."

#: includes/abilities.php:5135
msgid "New content (optional — some CPTs use meta fields instead)."
msgstr "Nuevo contenido (opcional: algunos CPT usan campos meta)."

#: includes/abilities.php:5139
msgid "New excerpt."
msgstr "Nuevo extracto."

#: includes/abilities.php:5143
msgid "New status: draft, publish, pending, private."
msgstr "Nuevo estado: draft, publish, pending, private."

#: includes/abilities.php:5147
msgid "Attachment ID for the featured image. Pass 0 to remove."
msgstr "ID del adjunto para la imagen destacada. Pasa 0 para eliminarla."

#: includes/abilities.php:5151
msgid "New URL slug."
msgstr "Nuevo slug de URL."

#: includes/abilities.php:5155
msgid ""
"Object mapping taxonomy slugs to arrays of term slugs or IDs. Replaces "
"existing terms."
msgstr ""
"Objeto que mapea slugs de taxonomía a arrays de slugs o IDs de términos. "
"Reemplaza los términos existentes."

#: includes/abilities.php:5189 includes/abilities.php:5509
#: includes/abilities.php:5634
msgid "You do not have permission to edit this item."
msgstr "No tienes permiso para editar este elemento."

#. translators: %s: post type label
#: includes/abilities.php:5256
#, php-format
msgid "%s updated successfully."
msgstr "%s actualizado correctamente."

#: includes/abilities.php:5277
msgid ""
"Deletes a custom post type item. By default moves to trash; use force_delete "
"to permanently remove."
msgstr ""
"Elimina un elemento de tipo de contenido personalizado. Por defecto lo mueve "
"a la papelera; usa force_delete para eliminarlo permanentemente."

#: includes/abilities.php:5285
msgid "The ID of the item to delete."
msgstr "El ID del elemento a eliminar."

#: includes/abilities.php:5289
msgid "If true, permanently deletes instead of trashing (default false)."
msgstr ""
"Si es verdadero, elimina permanentemente en lugar de mover a la papelera "
"(por defecto false)."

#: includes/abilities.php:5319
msgid "You do not have permission to delete this item."
msgstr "No tienes permiso para eliminar este elemento."

#: includes/abilities.php:5326
msgid "Failed to delete the item."
msgstr "No se ha podido eliminar el elemento."

#. translators: %s: post type label
#: includes/abilities.php:5336
#, php-format
msgid "%s permanently deleted."
msgstr "%s eliminado permanentemente."

#. translators: %s: post type label
#: includes/abilities.php:5341
#, php-format
msgid "%s moved to trash."
msgstr "%s movido a la papelera."

#: includes/abilities.php:5362
msgid ""
"Retrieves all taxonomies associated with a custom post type, including their "
"terms."
msgstr ""
"Recupera todas las taxonomías asociadas a un tipo de contenido "
"personalizado, incluyendo sus términos."

#: includes/abilities.php:5374
msgid "If true, only show terms with posts (default false)."
msgstr ""
"Si es verdadero, muestra solo los términos con entradas (por defecto false)."

#: includes/abilities.php:5378
msgid "Max number of terms per taxonomy (default 100, max 500)."
msgstr "Número máximo de términos por taxonomía (por defecto 100, máximo 500)."

#: includes/abilities.php:5458
msgid "Assign CPT Terms"
msgstr "Asignar términos de CPT"

#: includes/abilities.php:5459
msgid ""
"Assigns taxonomy terms to a custom post type item. Can replace or append "
"terms."
msgstr ""
"Asigna términos de taxonomía a un elemento de tipo de contenido "
"personalizado. Puede reemplazar o añadir términos."

#: includes/abilities.php:5467
msgid "The ID of the item to assign terms to."
msgstr "El ID del elemento al que asignar términos."

#: includes/abilities.php:5471 includes/abilities.php:5597
msgid "The taxonomy slug."
msgstr "El slug de la taxonomía."

#: includes/abilities.php:5475 includes/abilities.php:5601
msgid "Array of term slugs or IDs to assign."
msgstr "Array de slugs o IDs de términos a asignar."

#: includes/abilities.php:5479 includes/abilities.php:5605
msgid "If true, appends terms instead of replacing (default false)."
msgstr ""
"Si es verdadero, añade términos en lugar de reemplazarlos (por defecto "
"false)."

#: includes/abilities.php:5515 includes/abilities.php:5640
msgid "The specified taxonomy does not exist."
msgstr "La taxonomía especificada no existe."

#. translators: %1$s: taxonomy slug, %2$s: post type label
#. translators: %1$s: taxonomy slug, %2$s: post type
#: includes/abilities.php:5523 includes/abilities.php:5648
#, php-format
msgid "The taxonomy \"%1$s\" is not associated with the \"%2$s\" post type."
msgstr "La taxonomía «%1$s» no está asociada al tipo de contenido «%2$s»."

#: includes/abilities.php:5532 includes/abilities.php:5657
msgid "You do not have permission to assign terms for this taxonomy."
msgstr "No tienes permiso para asignar términos de esta taxonomía."

#. translators: %1$d: number of terms, %2$s: taxonomy label
#: includes/abilities.php:5563 includes/abilities.php:5688
#, php-format
msgid "%1$d term(s) assigned for %2$s."
msgstr "%1$d término(s) asignado(s) para %2$s."

#: includes/abilities.php:5585
msgid ""
"Assigns taxonomy terms to a post or page. For a custom taxonomy registered "
"on the built-in post/page types (e.g. by a companion plugin) — native "
"categories and tags on posts already have dedicated abilities via ewpa/"
"update-post. Can replace or append terms."
msgstr ""
"Asigna términos de taxonomía a una entrada o página. Pensada para taxonomías "
"personalizadas registradas en los tipos nativos entrada/página (p. ej., por "
"un plugin complementario); las categorías y etiquetas nativas de las "
"entradas ya tienen capacidades dedicadas mediante ewpa/update-post. Puede "
"reemplazar o añadir términos."

#: includes/abilities.php:5593
msgid "The ID of the post or page to assign terms to."
msgstr "El ID de la entrada o página a la que se asignarán los términos."

#: includes/abilities.php:5630
msgid ""
"This ability only assigns terms to posts and pages. Use ewpa/assign-cpt-"
"terms for custom post types."
msgstr ""
"Esta capacidad solo asigna términos a entradas y páginas. Usa ewpa/assign-"
"cpt-terms para tipos de contenido personalizados."

#: includes/abilities.php:5714
msgid ""
"Reads term meta for a taxonomy term. Pass meta_key to read a single field by "
"exact key, or omit it to return all meta fields for the term."
msgstr ""
"Lee los metadatos de un término de taxonomía. Indica meta_key para leer un "
"único campo por clave exacta, u omítelo para devolver todos los campos de "
"metadatos del término."

#: includes/abilities.php:5722 includes/abilities.php:5824
#: includes/abilities.php:5908
msgid "Taxonomy slug the term belongs to (e.g. category, tour_categoria)."
msgstr ""
"Slug de la taxonomía a la que pertenece el término (p. ej., category, "
"tour_categoria)."

#: includes/abilities.php:5726
msgid "ID of the term to read."
msgstr "ID del término que se leerá."

#: includes/abilities.php:5730
msgid "Exact meta key to read. Omit to return every meta field for the term."
msgstr ""
"Clave de metadato exacta que se leerá. Omítela para devolver todos los "
"campos de metadatos del término."

#: includes/abilities.php:5758 includes/abilities.php:5862
#: includes/abilities.php:5952
msgid "Term not found for the given taxonomy."
msgstr "No se encontró el término en la taxonomía indicada."

#: includes/abilities.php:5816
msgid ""
"Writes a term meta field by exact key. Requires edit_term capability on the "
"target term."
msgstr ""
"Escribe un campo de metadato de un término por clave exacta. Requiere la "
"capacidad edit_term en el término de destino."

#: includes/abilities.php:5828 includes/abilities.php:5912
msgid "ID of the term to update."
msgstr "ID del término que se actualizará."

#: includes/abilities.php:5832
msgid "Exact meta key to write."
msgstr "Clave de metadato exacta que se escribirá."

#: includes/abilities.php:5836
msgid "Value to store. Always stored as a string."
msgstr "Valor que se guardará. Siempre se guarda como texto."

#. translators: 1: meta key, 2: term id
#: includes/abilities.php:5874
#, php-format
msgid "Meta key \"%1$s\" updated for term %2$d."
msgstr "Clave de metadato \"%1$s\" actualizada en el término %2$d."

#: includes/abilities.php:5900
msgid ""
"Updates the core (non-meta) fields of an existing taxonomy term: name, slug, "
"description, or parent. Only the provided fields are modified."
msgstr ""
"Actualiza los campos principales (no metadatos) de un término de taxonomía "
"existente: nombre, slug, descripción o superior. Solo se modifican los "
"campos indicados."

#: includes/abilities.php:5916
msgid "New term name."
msgstr "Nuevo nombre del término."

#: includes/abilities.php:5920
msgid "New term slug."
msgstr "Nuevo slug del término."

#: includes/abilities.php:5924
msgid "New term description."
msgstr "Nueva descripción del término."

#: includes/abilities.php:5928
msgid "New parent term ID (0 = no parent)."
msgstr "ID del nuevo término superior (0 = sin superior)."

#: includes/abilities.php:5970
msgid "Provide at least one of: name, slug, description, parent."
msgstr "Indica al menos uno de estos campos: name, slug, description, parent."

#. translators: %d: term id
#: includes/abilities.php:5987
#, php-format
msgid "Term %d updated."
msgstr "Término %d actualizado."

#: includes/abilities.php:6014
msgid "List WooCommerce products"
msgstr "Listar productos de WooCommerce"

#: includes/abilities.php:6016
msgid ""
"Returns a paginated list of WooCommerce products with price, stock, and "
"status."
msgstr ""
"Devuelve una lista paginada de productos de WooCommerce con precio, stock y "
"estado."

#: includes/abilities.php:6022
msgid "Product status: publish, draft, pending. Default: publish."
msgstr "Estado del producto: publish, draft, pending. Por defecto: publish."

#: includes/abilities.php:6026 includes/abilities.php:6324
#: includes/abilities.php:6571 includes/abilities.php:6666
msgid "Results per page (1–100). Default: 10."
msgstr "Resultados por página (1–100). Por defecto: 10."

#: includes/abilities.php:6030 includes/abilities.php:6328
#: includes/abilities.php:6575 includes/abilities.php:6670
#: includes/abilities.php:8680 includes/abilities.php:9283
#: includes/abilities.php:10260
msgid "Page number. Default: 1."
msgstr "Número de página. Por defecto: 1."

#: includes/abilities.php:6034
msgid "Keyword search in product name."
msgstr "Búsqueda por palabra clave en el nombre del producto."

#: includes/abilities.php:6038
msgid "Filter by product category slug."
msgstr "Filtrar por slug de categoría de producto."

#: includes/abilities.php:6042
msgid "Order by: date, price, popularity, rating. Default: date."
msgstr "Ordenar por: date, price, popularity, rating. Por defecto: date."

#: includes/abilities.php:6046 includes/abilities.php:6587
msgid "Sort order: ASC or DESC. Default: DESC."
msgstr "Orden de clasificación: ASC o DESC. Por defecto: DESC."

#: includes/abilities.php:6119
msgid "Get WooCommerce product"
msgstr "Obtener producto de WooCommerce"

#: includes/abilities.php:6121
msgid "Returns full details of a single WooCommerce product by ID."
msgstr "Devuelve los detalles completos de un producto de WooCommerce por ID."

#: includes/abilities.php:6127 includes/abilities.php:6222
msgid "The product post ID."
msgstr "El ID de la entrada del producto."

#: includes/abilities.php:6140 includes/abilities.php:6259
msgid "Product not found."
msgstr "Producto no encontrado."

#: includes/abilities.php:6214
msgid "Update WooCommerce product"
msgstr "Actualizar producto de WooCommerce"

#: includes/abilities.php:6216
msgid ""
"Updates price, stock, status, or description of a WooCommerce product using "
"WooCommerce hooks."
msgstr ""
