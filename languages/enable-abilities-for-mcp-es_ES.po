#. Plugin Name of the plugin
#: enable-abilities-for-mcp.php
#: includes/admin.php:578
msgid "Enable Abilities for MCP"
msgstr "Enable Abilities for MCP"

#. Plugin URI of the plugin
#: enable-abilities-for-mcp.php
msgid "https://mcp.fabiomontenegro.com/"
msgstr "https://mcp.fabiomontenegro.com/"

#. Author of the plugin
#: enable-abilities-for-mcp.php
msgid "Fabio Montenegro"
msgstr "Fabio Montenegro"

#. Author URI of the plugin
#: enable-abilities-for-mcp.php
msgid "https://fabiomontenegro.com"
msgstr "https://fabiomontenegro.com"

#: enable-abilities-for-mcp.php:1223
msgid "WordPress Core"
msgstr "WordPress Core"

#: enable-abilities-for-mcp.php:1224
msgid "Native WordPress core abilities. Exposed to MCP with the public flag."
msgstr "Capacidades nativas del núcleo de WordPress. Se exponen a MCP con la marca pública."

#: enable-abilities-for-mcp.php:1228
#: includes/abilities.php:761
msgid "Site Information"
msgstr "Información del sitio"

#: enable-abilities-for-mcp.php:1229
msgid "General site data: name, URL, description, language, timezone, WP version."
msgstr "Datos generales del sitio: nombre, URL, descripción, idioma, zona horaria y versión de WP."

#: enable-abilities-for-mcp.php:1232
msgid "User Information"
msgstr "Información del usuario"

#: enable-abilities-for-mcp.php:1233
msgid "Current user data: name, email, role, avatar."
msgstr "Datos del usuario actual: nombre, correo electrónico, rol y avatar."

#: enable-abilities-for-mcp.php:1236
msgid "Environment Information"
msgstr "Información del entorno"

#: enable-abilities-for-mcp.php:1237
msgid "Technical details: PHP version, DB server, environment type."
msgstr "Detalles técnicos: versión de PHP, servidor de base de datos y tipo de entorno."

#: enable-abilities-for-mcp.php:1242
msgid "Read (Query Only)"
msgstr "Lectura (solo consulta)"

#: enable-abilities-for-mcp.php:1243
msgid "Only query data, do not modify anything. Safest to expose via MCP."
msgstr "Solo consulta datos, no modifica nada. La opción más segura para exponer a través de MCP."

#: enable-abilities-for-mcp.php:1247
#: includes/abilities.php:888
msgid "Get Posts"
msgstr "Obtener entradas"

#: enable-abilities-for-mcp.php:1248
msgid "List posts with filters by status, category, count, and order."
msgstr "Lista entradas con filtros por estado, categoría, cantidad y orden."

#: enable-abilities-for-mcp.php:1251
#: includes/abilities.php:1055
msgid "Get Single Post"
msgstr "Obtener una entrada"

#: enable-abilities-for-mcp.php:1252
msgid "Full post detail by ID, including content, meta data, and featured image."
msgstr "Detalle completo de una entrada por ID, incluyendo contenido, metadatos e imagen destacada."

#: enable-abilities-for-mcp.php:1255
#: includes/abilities.php:1226
msgid "Get Categories"
msgstr "Obtener categorías"

#: enable-abilities-for-mcp.php:1256
msgid "List all categories with ID, name, slug, and post count."
msgstr "Lista todas las categorías con ID, nombre, slug y recuento de entradas."

#: enable-abilities-for-mcp.php:1259
#: includes/abilities.php:1290
msgid "Get Tags"
msgstr "Obtener etiquetas"

#: enable-abilities-for-mcp.php:1260
msgid "List all tags with ID, name, slug, and post count."
msgstr "Lista todas las etiquetas con ID, nombre, slug y recuento de entradas."

#: enable-abilities-for-mcp.php:1263
#: includes/abilities.php:1358
msgid "Get Pages"
msgstr "Obtener páginas"

#: enable-abilities-for-mcp.php:1264
msgid "List site pages with title, status, and hierarchy."
msgstr "Lista las páginas del sitio con título, estado y jerarquía."

#: enable-abilities-for-mcp.php:1267
#: includes/abilities.php:1143
msgid "Get Single Page"
msgstr "Obtener una página"

#: enable-abilities-for-mcp.php:1268
msgid "Full page detail by ID, including content, template, hierarchy, and SEO metadata."
msgstr "Detalle completo de una página por ID, incluyendo contenido, plantilla, jerarquía y metadatos SEO."

#: enable-abilities-for-mcp.php:1271
#: includes/abilities.php:1449
msgid "Get Comments"
msgstr "Obtener comentarios"

#: enable-abilities-for-mcp.php:1272
msgid "List comments with filters by status, post, and count."
msgstr "Lista comentarios con filtros por estado, entrada y cantidad."

#: enable-abilities-for-mcp.php:1275
#: includes/abilities.php:1538
msgid "Get Media"
msgstr "Obtener medios"

#: enable-abilities-for-mcp.php:1276
msgid "List media library files with filters by type."
msgstr "Lista los archivos de la biblioteca de medios con filtros por tipo."

#: enable-abilities-for-mcp.php:1279
#: includes/abilities.php:1625
msgid "Get Users"
msgstr "Obtener usuarios"

#: enable-abilities-for-mcp.php:1280
msgid "List site users with ID, name, email, and role."
msgstr "Lista los usuarios del sitio con ID, nombre, correo electrónico y rol."

#: enable-abilities-for-mcp.php:1285
msgid "Write (Create & Modify)"
msgstr "Escritura (crear y modificar)"

#: enable-abilities-for-mcp.php:1286
msgid "Create or modify content. Require appropriate MCP user permissions."
msgstr "Crea o modifica contenido. Requiere los permisos de usuario MCP adecuados."

#: enable-abilities-for-mcp.php:1291
#: includes/abilities.php:1695
msgid "Create Post"
msgstr "Crear entrada"

#: enable-abilities-for-mcp.php:1292
msgid "Create a new post with title, content, categories, tags, featured image, and more."
msgstr "Crea una nueva entrada con título, contenido, categorías, etiquetas, imagen destacada y más."

#: enable-abilities-for-mcp.php:1295
#: includes/abilities.php:1887
msgid "Update Post"
msgstr "Actualizar entrada"

#: enable-abilities-for-mcp.php:1296
msgid "Modify an existing post. Only updates the fields provided."
msgstr "Modifica una entrada existente. Solo actualiza los campos proporcionados."

#: enable-abilities-for-mcp.php:1299
#: includes/abilities.php:2030
msgid "Delete Post"
msgstr "Eliminar entrada"

#: enable-abilities-for-mcp.php:1300
msgid "Send a post to trash or permanently delete it."
msgstr "Envía una entrada a la papelera o la elimina de forma permanente."

#: enable-abilities-for-mcp.php:1303
#: includes/abilities.php:2098
msgid "Create Category"
msgstr "Crear categoría"

#: enable-abilities-for-mcp.php:1304
msgid "Create a new category with name, slug, description, and parent."
msgstr "Crea una nueva categoría con nombre, slug, descripción y categoría padre."

#: enable-abilities-for-mcp.php:1307
#: includes/abilities.php:2181
msgid "Create Tag"
msgstr "Crear etiqueta"

#: enable-abilities-for-mcp.php:1308
msgid "Create a new tag with name, slug, and description."
msgstr "Crea una nueva etiqueta con nombre, slug y descripción."

#: enable-abilities-for-mcp.php:1311
#: includes/abilities.php:2256
msgid "Create Page"
msgstr "Crear página"

#: enable-abilities-for-mcp.php:1312
msgid "Create a new page with title, content, status, and parent page."
msgstr "Crea una nueva página con título, contenido, estado y página padre."

#: enable-abilities-for-mcp.php:1315
#: includes/abilities.php:2353
msgid "Moderate Comment"
msgstr "Moderar comentario"

#: enable-abilities-for-mcp.php:1316
msgid "Change comment status: approve, hold, spam, or trash."
msgstr "Cambia el estado de un comentario: aprobar, retener, spam o papelera."

#: enable-abilities-for-mcp.php:1319
#: includes/abilities.php:2435
msgid "Reply to Comment"
msgstr "Responder a comentario"

#: enable-abilities-for-mcp.php:1320
msgid "Reply to an existing comment as the authenticated user."
msgstr "Responde a un comentario existente como el usuario autenticado."

#: enable-abilities-for-mcp.php:1323
#: includes/abilities.php:2514
msgid "Update Comment"
msgstr "Actualizar comentario"

#: enable-abilities-for-mcp.php:1324
msgid "Update content, author name, email, or WordPress user of an existing comment."
msgstr "Actualiza el contenido, nombre del autor, correo electrónico o usuario de WordPress de un comentario existente."

#: enable-abilities-for-mcp.php:1327
#: includes/abilities.php:2635
msgid "Upload Image from URL"
msgstr "Subir imagen desde URL"

#: enable-abilities-for-mcp.php:1328
msgid "Download an image from an external URL and register it in the media library. Returns the attachment ID."
msgstr "Descarga una imagen de una URL externa y la registra en la biblioteca de medios. Devuelve el ID del adjunto."

#: enable-abilities-for-mcp.php:1341
#: includes/abilities.php:2807
msgid "Duplicate Post / Page / CPT"
msgstr "Duplicar entrada / página / CPT"

#: enable-abilities-for-mcp.php:1342
msgid "Create an exact copy of any post, page, or CPT item — including all meta and taxonomy terms. The duplicate is saved as draft by default."
msgstr "Crea una copia exacta de cualquier entrada, página o elemento de CPT, incluidos todos sus metadatos y términos de taxonomía. El duplicado se guarda como borrador por defecto."

#: enable-abilities-for-mcp.php:1345
#: includes/abilities.php:6481
msgid "Assign Post Terms"
msgstr "Asignar términos a entradas"

#: enable-abilities-for-mcp.php:1346
msgid "Assign a custom taxonomy's terms to a post or page (e.g. a taxonomy registered by a companion plugin). Native categories and tags are already covered by ewpa/update-post."
msgstr "Asigna términos de una taxonomía personalizada a una entrada o página (p. ej., una taxonomía registrada por un plugin complementario). Las categorías y etiquetas nativas ya están cubiertas por ewpa/update-post."

#: enable-abilities-for-mcp.php:1351
msgid "SEO — Rank Math"
msgstr "SEO — Rank Math"

#: enable-abilities-for-mcp.php:1352
msgid "Query and update Rank Math SEO metadata on posts and pages."
msgstr "Consulta y actualiza los metadatos SEO de Rank Math en entradas y páginas."

#: enable-abilities-for-mcp.php:1357
#: includes/abilities.php:2943
msgid "Get Rank Math Metadata"
msgstr "Obtener metadatos de Rank Math"

#: enable-abilities-for-mcp.php:1358
msgid "Get Rank Math SEO metadata for a post or page: title, description, keywords, robots, Open Graph, and more."
msgstr "Obtiene los metadatos SEO de Rank Math para una entrada o página: título, descripción, palabras clave, robots, Open Graph y más."

#: enable-abilities-for-mcp.php:1361
#: includes/abilities.php:3068
msgid "Update Rank Math SEO / Focus Keyword"
msgstr "Actualizar SEO de Rank Math / Palabra clave principal"

#: enable-abilities-for-mcp.php:1362
msgid "Update focus keyword, SEO title, description, canonical URL, robots, and Open Graph via Rank Math."
msgstr "Actualiza la palabra clave principal, el título SEO, la descripción, la URL canónica, los robots y Open Graph a través de Rank Math."

#: enable-abilities-for-mcp.php:1365
#: includes/abilities.php:3351
msgid "Update Rank Math Schema"
msgstr "Actualizar esquema de Rank Math"

#: enable-abilities-for-mcp.php:1366
msgid "Write a structured-data schema block (FAQPage, Article, Product, etc.) to a Rank Math schema meta key as a PHP-serialized array, so it renders as JSON-LD in <head>."
msgstr "Escribe un bloque de datos estructurados (FAQPage, Article, Product, etc.) en la clave meta de esquema de Rank Math como un array serializado en PHP, de modo que se muestre como JSON-LD en el <head>."

#: enable-abilities-for-mcp.php:1371
msgid "SEO — SEOPress"
msgstr "SEO — SEOPress"

#: enable-abilities-for-mcp.php:1372
msgid "Query and update SEOPress metadata on posts and pages."
msgstr "Consulta y actualiza los metadatos de SEOPress en entradas y páginas."

#: enable-abilities-for-mcp.php:1377
#: includes/abilities.php:3429
msgid "Get SEOPress Metadata"
msgstr "Obtener metadatos de SEOPress"

#: enable-abilities-for-mcp.php:1378
msgid "Get SEOPress metadata for a post or page: title, description, focus keyword, robots, canonical, Open Graph, and Twitter Card."
msgstr "Obtiene los metadatos de SEOPress para una entrada o página: título, descripción, palabra clave principal, robots, URL canónica, Open Graph y Twitter Card."

#: enable-abilities-for-mcp.php:1381
#: includes/abilities.php:3512
msgid "Update SEOPress Metadata"
msgstr "Actualizar metadatos de SEOPress"

#: enable-abilities-for-mcp.php:1382
msgid "Update SEOPress SEO title, description, focus keyword, canonical URL, robots directives, and Open Graph / Twitter Card fields."
msgstr "Actualiza el título SEO, la descripción, la palabra clave principal, la URL canónica, las directivas de robots y los campos de Open Graph/Twitter Card de SEOPress."

#: enable-abilities-for-mcp.php:1385
#: includes/abilities.php:3719
msgid "Get SEOPress Content Analysis"
msgstr "Obtener análisis de contenido de SEOPress"

#: enable-abilities-for-mcp.php:1386
msgid "Read the SEOPress content analysis checks and recommendations for a post or page, optionally running a fresh analysis first. Requires SEOPress 7.5+."
msgstr "Lee las comprobaciones y recomendaciones del análisis de contenido de SEOPress para una entrada o página, con opción de ejecutar primero un análisis nuevo. Requiere SEOPress 7.5+."

#: enable-abilities-for-mcp.php:1391
msgid "SEO — Yoast SEO"
msgstr "SEO — Yoast SEO"

#: enable-abilities-for-mcp.php:1392
msgid "Query and update Yoast SEO metadata on posts and pages."
msgstr "Consulta y actualiza los metadatos de Yoast SEO en entradas y páginas."

#: enable-abilities-for-mcp.php:1397
#: includes/abilities.php:3888
msgid "Get Yoast SEO Metadata"
msgstr "Obtener metadatos de Yoast SEO"

#: enable-abilities-for-mcp.php:1398
msgid "Get Yoast SEO metadata for a post or page: title, description, focus keyphrase, canonical, robots, Open Graph, and Twitter Card."
msgstr "Obtiene los metadatos de Yoast SEO para una entrada o página: título, descripción, frase clave principal, URL canónica, robots, Open Graph y Twitter Card."

#: enable-abilities-for-mcp.php:1401
#: includes/abilities.php:3967
msgid "Update Yoast SEO Metadata"
msgstr "Actualizar metadatos de Yoast SEO"

#: enable-abilities-for-mcp.php:1402
msgid "Update Yoast SEO title, description, focus keyphrase, canonical URL, robots, and Open Graph / Twitter Card fields."
msgstr "Actualiza el título SEO, la descripción, la frase clave principal, la URL canónica, los robots y los campos de Open Graph/Twitter Card de Yoast SEO."

#: enable-abilities-for-mcp.php:1405
#: includes/abilities.php:4703
msgid "Get Yoast Sitemap Index"
msgstr "Obtener índice del mapa del sitio de Yoast"

#: enable-abilities-for-mcp.php:1406
msgid "Fetch and parse the Yoast SEO sitemap index, returning the list of all sitemap URLs registered on the site."
msgstr "Obtiene y analiza el índice del mapa del sitio de Yoast SEO, devolviendo la lista de todas las URLs de los mapas del sitio registrados."

#: enable-abilities-for-mcp.php:1411
#: includes/abilities.php:777
msgid "Navigation Menus"
msgstr "Menús de navegación"

#: enable-abilities-for-mcp.php:1412
msgid "Inspect and manage navigation menus, their items, and theme locations."
msgstr "Inspecciona y gestiona los menús de navegación, sus elementos y las ubicaciones del tema."

#: enable-abilities-for-mcp.php:1416
#: includes/abilities.php:11320
msgid "Create Menu"
msgstr "Crear menú"

#: enable-abilities-for-mcp.php:1417
msgid "Creates a new, empty navigation menu with the given name."
msgstr "Crea un nuevo menú de navegación vacío con el nombre indicado."

#: enable-abilities-for-mcp.php:1420
#: includes/abilities.php:11378
msgid "List Menus"
msgstr "Listar menús"

#: enable-abilities-for-mcp.php:1421
msgid "Lists every menu with its id, slug, and item count, plus the theme locations and which menu each one displays."
msgstr "Lista todos los menús con su id, slug y cantidad de elementos, además de las ubicaciones del tema y qué menú muestra cada una."

#: enable-abilities-for-mcp.php:1424
#: includes/abilities.php:11432
msgid "Get Menu"
msgstr "Obtener menú"

#: enable-abilities-for-mcp.php:1425
msgid "Returns every item of one menu with hierarchy, destination, and position."
msgstr "Devuelve todos los elementos de un menú con su jerarquía, destino y posición."

#: enable-abilities-for-mcp.php:1428
#: includes/abilities.php:11496
msgid "Add Menu Item"
msgstr "Agregar elemento de menú"

#: enable-abilities-for-mcp.php:1429
msgid "Adds a page, post, category, tag, or custom URL to a menu, with optional parent and position."
msgstr "Agrega una página, entrada, categoría, etiqueta o URL personalizada a un menú, con padre y posición opcionales."

#: enable-abilities-for-mcp.php:1432
#: includes/abilities.php:11606
msgid "Update Menu Item"
msgstr "Actualizar elemento de menú"

#: enable-abilities-for-mcp.php:1433
msgid "Updates the title, custom URL, parent, or position of one menu item."
msgstr "Actualiza el título, la URL personalizada, el padre o la posición de un elemento de menú."

#: enable-abilities-for-mcp.php:1436
#: includes/abilities.php:11686
msgid "Remove Menu Item"
msgstr "Quitar elemento de menú"

#: enable-abilities-for-mcp.php:1437
msgid "Permanently removes one item from a menu. Destructive — opt-in required."
msgstr "Quita permanentemente un elemento de un menú. Destructivo: requiere activación explícita."

#: enable-abilities-for-mcp.php:1441
#: includes/abilities.php:11736
msgid "Assign Menu Location"
msgstr "Asignar ubicación de menú"

#: enable-abilities-for-mcp.php:1442
msgid "Assigns a menu to a theme location. Changes site-wide navigation — opt-in required."
msgstr "Asigna un menú a una ubicación del tema. Cambia la navegación de todo el sitio: requiere activación explícita."

#: enable-abilities-for-mcp.php:1446
#: includes/abilities.php:11801
msgid "Delete Menu"
msgstr "Eliminar menú"

#: enable-abilities-for-mcp.php:1447
msgid "Permanently deletes a menu and all of its items. Destructive — opt-in required."
msgstr "Elimina permanentemente un menú y todos sus elementos. Destructivo: requiere activación explícita."

#: enable-abilities-for-mcp.php:1453
msgid "Utility"
msgstr "Utilidades"

#: enable-abilities-for-mcp.php:1454
msgid "Auxiliary tools that complement the workflow."
msgstr "Herramientas auxiliares que complementan el flujo de trabajo."

#: enable-abilities-for-mcp.php:1458
#: includes/abilities.php:4793
msgid "Search and Replace"
msgstr "Buscar y reemplazar"

#: enable-abilities-for-mcp.php:1459
msgid "Search for text in a post content and replace it with another."
msgstr "Busca texto en el contenido de una entrada y lo reemplaza por otro."

#: enable-abilities-for-mcp.php:1462
#: includes/abilities.php:4882
msgid "Site Statistics"
msgstr "Estadísticas del sitio"

#: enable-abilities-for-mcp.php:1463
msgid "Site summary: total posts, pages, categories, tags, comments, and users."
msgstr "Resumen del sitio: total de entradas, páginas, categorías, etiquetas, comentarios y usuarios."

#: enable-abilities-for-mcp.php:1466
#: includes/abilities.php:4957
msgid "Update Post Meta"
msgstr "Actualizar metadato de entrada"

#: enable-abilities-for-mcp.php:1467
msgid "Write any post meta field by exact key. Requires edit_post capability on the target post."
msgstr "Escribe cualquier campo de metadato de una entrada por clave exacta. Requiere la capacidad edit_post en la entrada de destino."

#: enable-abilities-for-mcp.php:1470
#: includes/abilities.php:5055
msgid "Get Post Meta"
msgstr "Obtener metadato de entrada"

#: enable-abilities-for-mcp.php:1471
msgid "Read any single post meta field by exact key. Returns the value and whether the key exists."
msgstr "Lee cualquier campo de metadato de una entrada por clave exacta. Devuelve el valor e indica si la clave existe."

#: enable-abilities-for-mcp.php:1474
#: includes/abilities.php:5127
msgid "Get Active Plugins"
msgstr "Obtener plugins activos"

#: enable-abilities-for-mcp.php:1475
msgid "Returns all active plugins with name, version, and detected capabilities (SEO, multilanguage, WooCommerce, etc.)."
msgstr "Devuelve todos los plugins activos con nombre, versión y capacidades detectadas (SEO, multiidioma, WooCommerce, etc.)."

#: enable-abilities-for-mcp.php:1478
#: includes/abilities.php:5239
msgid "Clear Cache"
msgstr "Limpiar caché"

#: enable-abilities-for-mcp.php:1479
msgid "Purge the page cache for one post or the whole site. Auto-detects WP Rocket, LiteSpeed Cache, W3 Total Cache, WP Super Cache, and WP Fastest Cache. Essential after meta-only writes (SEO fixes, Elementor edits) that do not trigger the cache plugin's own purge."
msgstr "Purga la caché de página de una entrada o de todo el sitio. Detecta automáticamente WP Rocket, LiteSpeed Cache, W3 Total Cache, WP Super Cache y WP Fastest Cache. Esencial tras escrituras solo de metadatos (correcciones SEO, ediciones de Elementor) que no activan la purga propia del plugin de caché."

#: enable-abilities-for-mcp.php:1484
msgid "Code Snippets"
msgstr "Fragmentos de código"

#: enable-abilities-for-mcp.php:1485
msgid "Create, read, and update PHP code snippets via the Code Snippets plugin. Requires manage_options. New snippets are saved inactive, and activating one always needs an administrator to review the code and confirm it in wp-admin."
msgstr "Crea, lee y actualiza fragmentos de código PHP mediante el plugin Code Snippets. Requiere manage_options. Los fragmentos nuevos se guardan inactivos y activar uno siempre requiere que un administrador revise el código y lo confirme en wp-admin."

#: enable-abilities-for-mcp.php:1491
#: includes/abilities.php:4162
msgid "Create Code Snippet"
msgstr "Crear fragmento de código"

#: enable-abilities-for-mcp.php:1492
msgid "Creates a PHP snippet (always inactive). Validates syntax, blocks dangerous functions (eval, exec, shell_exec, etc.), and fires an audit action hook."
msgstr "Crea un fragmento PHP (siempre inactivo). Valida la sintaxis, bloquea funciones peligrosas (eval, exec, shell_exec, etc.) y activa un hook de auditoría."

#: enable-abilities-for-mcp.php:1495
#: includes/abilities.php:4285
msgid "List Code Snippets"
msgstr "Listar fragmentos de código"

#: enable-abilities-for-mcp.php:1496
msgid "List snippets with name, type, scope, active state, and tags. The code itself is not included."
msgstr "Lista los fragmentos con nombre, tipo, ámbito, estado y etiquetas. No incluye el código."

#: enable-abilities-for-mcp.php:1499
#: includes/abilities.php:4372
msgid "Get Code Snippet"
msgstr "Obtener fragmento de código"

#: enable-abilities-for-mcp.php:1500
msgid "Read one snippet by ID, including its code."
msgstr "Lee un fragmento por ID, incluido su código."

#: enable-abilities-for-mcp.php:1503
#: includes/abilities.php:4433
msgid "Update Code Snippet"
msgstr "Actualizar fragmento de código"

#: enable-abilities-for-mcp.php:1504
msgid "Change a PHP snippet's name, description, code, scope, or tags. New code is validated; an active snippet whose code changes is deactivated. Opt-in required."
msgstr "Cambia el nombre, la descripción, el código, el ámbito o las etiquetas de un fragmento PHP. El código nuevo se valida; un fragmento activo cuyo código cambia se desactiva. Requiere activación manual."

#: enable-abilities-for-mcp.php:1508
#: includes/abilities.php:4590
msgid "Set Code Snippet Active"
msgstr "Activar o desactivar fragmento de código"

#: enable-abilities-for-mcp.php:1509
msgid "Deactivate a snippet, or request its activation. Activation is never automatic: an administrator must review the code and confirm it in wp-admin. Opt-in required."
msgstr "Desactiva un fragmento o solicita su activación. La activación nunca es automática: un administrador debe revisar el código y confirmarla en wp-admin. Requiere activación manual."

#: enable-abilities-for-mcp.php:1515
#: includes/abilities.php:801
msgid "Multilanguage"
msgstr "Multiidioma"

#: enable-abilities-for-mcp.php:1516
msgid "List languages, create and link translations, and assign languages to posts and taxonomy terms via Polylang, WPML, or Linguator AI."
msgstr "Lista idiomas, crea y vincula traducciones, y asigna idiomas a entradas y términos de taxonomía mediante Polylang, WPML o Linguator AI."

#: enable-abilities-for-mcp.php:1522
#: includes/abilities.php:8025
msgid "List Languages"
msgstr "Listar idiomas"

#: enable-abilities-for-mcp.php:1523
msgid "List available languages from Polylang, WPML, or Linguator AI."
msgstr "Lista los idiomas disponibles en Polylang, WPML o Linguator AI."

#: enable-abilities-for-mcp.php:1526
#: includes/abilities.php:8217
msgid "Create Post Translation"
msgstr "Crear traducción de entrada"

#: enable-abilities-for-mcp.php:1527
msgid "Create the translation of a post in a target language and link it to the source. The AI supplies the translated text; taxonomies, custom fields and the featured image are copied over."
msgstr "Crea la traducción de una entrada en un idioma de destino y la vincula con la original. La IA aporta el texto traducido; las taxonomías, los campos personalizados y la imagen destacada se copian."

#: enable-abilities-for-mcp.php:1530
#: includes/abilities.php:8061
msgid "Set Post Language"
msgstr "Establecer idioma de la entrada"

#: enable-abilities-for-mcp.php:1531
msgid "Assign a language code to an existing post via Polylang, WPML, or Linguator AI."
msgstr "Asigna un código de idioma a una entrada existente mediante Polylang, WPML o Linguator AI."

#: enable-abilities-for-mcp.php:1534
#: includes/abilities.php:8108
msgid "Link Post Translation"
msgstr "Vincular traducción de entrada"

#: enable-abilities-for-mcp.php:1535
msgid "Link two posts as translations of each other in the same translation group."
msgstr "Vincula dos entradas como traducciones una de la otra dentro del mismo grupo de traducción."

#: enable-abilities-for-mcp.php:1538
#: includes/abilities.php:8163
msgid "Get Post Translations"
msgstr "Obtener traducciones de la entrada"

#: enable-abilities-for-mcp.php:1539
msgid "Return the full translation map for a post: language, post ID, title, permalink, and status for each available translation."
msgstr "Devuelve el mapa completo de traducciones de una entrada: idioma, ID de entrada, título, permalink y estado para cada traducción disponible."

#: enable-abilities-for-mcp.php:1542
#: includes/abilities.php:8485
msgid "Create Term Translation"
msgstr "Crear traducción de término"

#: enable-abilities-for-mcp.php:1543
msgid "Create the translation of a category, tag, or custom taxonomy term and link it to the source. The AI supplies the translated name and description; term meta is copied and the parent term is remapped."
msgstr "Crea la traducción de una categoría, etiqueta o término de taxonomía personalizada y la vincula con el original. La IA aporta el nombre y la descripción traducidos; los metadatos del término se copian y el término superior se reasigna."

#: enable-abilities-for-mcp.php:1546
#: includes/abilities.php:8318
msgid "Set Term Language"
msgstr "Establecer idioma del término"

#: enable-abilities-for-mcp.php:1547
msgid "Assign a language code to an existing taxonomy term via Polylang, WPML, or Linguator AI."
msgstr "Asigna un código de idioma a un término de taxonomía existente mediante Polylang, WPML o Linguator AI."

#: enable-abilities-for-mcp.php:1550
#: includes/abilities.php:8366
msgid "Link Term Translation"
msgstr "Vincular traducción de término"

#: enable-abilities-for-mcp.php:1551
msgid "Link two taxonomy terms as translations of each other in the same translation group."
msgstr "Vincula dos términos de taxonomía como traducciones uno del otro dentro del mismo grupo de traducción."

#: enable-abilities-for-mcp.php:1554
#: includes/abilities.php:8427
msgid "Get Term Translations"
msgstr "Obtener traducciones del término"

#: enable-abilities-for-mcp.php:1555
msgid "Return the full translation map for a taxonomy term: language, term ID, name, slug, description, count, and archive URL."
msgstr "Devuelve el mapa completo de traducciones de un término de taxonomía: idioma, ID del término, nombre, slug, descripción, recuento y URL del archivo."

#: enable-abilities-for-mcp.php:1560
#: includes/abilities.php:785
msgid "WooCommerce"
msgstr "WooCommerce"

#: enable-abilities-for-mcp.php:1561
msgid "Query and manage WooCommerce products, orders, and customers using the native WooCommerce API (HPOS-compatible)."
msgstr "Consulta y gestiona productos, pedidos y clientes de WooCommerce usando la API nativa de WooCommerce (compatible con HPOS)."

#: enable-abilities-for-mcp.php:1567
msgid "Get Products"
msgstr "Obtener productos"

#: enable-abilities-for-mcp.php:1568
msgid "List products with price, SKU, stock status, categories, and type. Supports search and category filter."
msgstr "Lista productos con precio, SKU, estado del stock, categorías y tipo. Admite búsqueda y filtro por categoría."

#: enable-abilities-for-mcp.php:1571
msgid "Get Single Product"
msgstr "Obtener un producto"

#: enable-abilities-for-mcp.php:1572
msgid "Full product detail: price, SKU, stock, description, gallery, attributes, and variations for variable products."
msgstr "Detalle completo del producto: precio, SKU, stock, descripción, galería, atributos y variaciones para productos variables."

#: enable-abilities-for-mcp.php:1575
msgid "Update Product"
msgstr "Actualizar producto"

#: enable-abilities-for-mcp.php:1576
msgid "Update product price, sale price, stock quantity, status, or description using the WooCommerce API."
msgstr "Actualiza el precio, precio de oferta, cantidad en stock, estado o descripción del producto usando la API de WooCommerce."

#: enable-abilities-for-mcp.php:1579
msgid "Get Orders"
msgstr "Obtener pedidos"

#: enable-abilities-for-mcp.php:1580
msgid "List orders with customer, total, status, and date. HPOS-compatible. Supports filter by status."
msgstr "Lista pedidos con cliente, total, estado y fecha. Compatible con HPOS. Admite filtro por estado."

#: enable-abilities-for-mcp.php:1583
msgid "Get Single Order"
msgstr "Obtener un pedido"

#: enable-abilities-for-mcp.php:1584
msgid "Full order detail: line items, customer billing/shipping, totals, status history, and notes."
msgstr "Detalle completo del pedido: líneas de pedido, facturación/envío del cliente, totales, historial de estados y notas."

#: enable-abilities-for-mcp.php:1587
msgid "Update Order Status"
msgstr "Actualizar estado del pedido"

#: enable-abilities-for-mcp.php:1588
msgid "Change the status of an order (e.g., pending → processing → completed) with an optional note."
msgstr "Cambia el estado de un pedido (p. ej., pendiente → procesando → completado) con una nota opcional."

#: enable-abilities-for-mcp.php:1591
msgid "Get Customers"
msgstr "Obtener clientes"

#: enable-abilities-for-mcp.php:1592
msgid "List customers with email, name, total spent, and order count. Supports search by email or name."
msgstr "Lista clientes con correo electrónico, nombre, total gastado y número de pedidos. Admite búsqueda por correo o nombre."

#: enable-abilities-for-mcp.php:1597
#: includes/abilities.php:793
msgid "The Events Calendar"
msgstr "The Events Calendar"

#: enable-abilities-for-mcp.php:1598
msgid "Query and manage events from The Events Calendar plugin, including dates, venues, and organizers."
msgstr "Consulta y gestiona eventos del plugin The Events Calendar, incluyendo fechas, lugares y organizadores."

#: enable-abilities-for-mcp.php:1603
msgid "Get Events"
msgstr "Obtener eventos"

#: enable-abilities-for-mcp.php:1604
msgid "List events with start/end date, venue, and organizer. Supports upcoming/past filter and date range."
msgstr "Lista eventos con fecha de inicio/fin, lugar y organizador. Admite filtro de próximos/pasados y rango de fechas."

#: enable-abilities-for-mcp.php:1607
msgid "Get Single Event"
msgstr "Obtener un evento"

#: enable-abilities-for-mcp.php:1608
msgid "Full event detail with resolved venue address and organizer contact info in a single call."
msgstr "Detalle completo del evento con la dirección del lugar y la información de contacto del organizador en una sola llamada."

#: enable-abilities-for-mcp.php:1611
msgid "Create Event"
msgstr "Crear evento"

#: enable-abilities-for-mcp.php:1612
msgid "Create a new event with title, description, start/end dates, timezone, and venue (by ID or name)."
msgstr "Crea un nuevo evento con título, descripción, fechas de inicio/fin, zona horaria y lugar (por ID o nombre)."

#: enable-abilities-for-mcp.php:1615
msgid "Update Event"
msgstr "Actualizar evento"

#: enable-abilities-for-mcp.php:1616
msgid "Update an existing event: title, description, start/end dates, timezone, or venue."
msgstr "Actualiza un evento existente: título, descripción, fechas de inicio/fin, zona horaria o lugar."

#: enable-abilities-for-mcp.php:1621
#: includes/abilities.php:769
msgid "Custom Post Types"
msgstr "Tipos de contenido personalizados"

#: enable-abilities-for-mcp.php:1622
msgid "Discover and manage Custom Post Types registered by plugins or themes. Excludes posts, pages, and attachments which have dedicated abilities."
msgstr "Descubre y gestiona los tipos de contenido personalizados registrados por plugins o temas. Excluye entradas, páginas y adjuntos, que tienen capacidades dedicadas."

#: enable-abilities-for-mcp.php:1628
#: includes/abilities.php:5376
msgid "List Post Types"
msgstr "Listar tipos de contenido"

#: enable-abilities-for-mcp.php:1629
msgid "List all public Custom Post Types with their labels, taxonomies, supported features, and capabilities."
msgstr "Lista todos los tipos de contenido personalizados públicos con sus etiquetas, taxonomías, características admitidas y capacidades."

#: enable-abilities-for-mcp.php:1632
#: includes/abilities.php:5469
msgid "Get CPT Items"
msgstr "Obtener elementos de CPT"

#: enable-abilities-for-mcp.php:1633
msgid "List items from any CPT with filters by status, count, order, and search."
msgstr "Lista elementos de cualquier tipo de contenido personalizado con filtros por estado, cantidad, orden y búsqueda."

#: enable-abilities-for-mcp.php:1636
msgid "Get Single CPT Item"
msgstr "Obtener un elemento de CPT"

#: enable-abilities-for-mcp.php:1637
msgid "Get full detail of a CPT item by ID, including content, meta data, taxonomies, and featured image."
msgstr "Obtiene el detalle completo de un elemento de CPT por ID, incluyendo contenido, metadatos, taxonomías e imagen destacada."

#: enable-abilities-for-mcp.php:1640
#: includes/abilities.php:5776
msgid "Create CPT Item"
msgstr "Crear elemento de CPT"

#: enable-abilities-for-mcp.php:1641
msgid "Create a new item in any CPT with title, content, status, taxonomies, and featured image."
msgstr "Crea un nuevo elemento en cualquier tipo de contenido personalizado con título, contenido, estado, taxonomías e imagen destacada."

#: enable-abilities-for-mcp.php:1644
#: includes/abilities.php:5974
msgid "Update CPT Item"
msgstr "Actualizar elemento de CPT"

#: enable-abilities-for-mcp.php:1645
msgid "Update an existing CPT item. Only modifies the fields provided."
msgstr "Actualiza un elemento de CPT existente. Solo modifica los campos proporcionados."

#: enable-abilities-for-mcp.php:1648
#: includes/abilities.php:6167
msgid "Delete CPT Item"
msgstr "Eliminar elemento de CPT"

#: enable-abilities-for-mcp.php:1649
msgid "Send a CPT item to trash or permanently delete it."
msgstr "Envía un elemento de CPT a la papelera o lo elimina de forma permanente."

#: enable-abilities-for-mcp.php:1652
#: includes/abilities.php:6252
msgid "Get CPT Taxonomies"
msgstr "Obtener taxonomías de CPT"

#: enable-abilities-for-mcp.php:1653
msgid "List taxonomies and their terms for a given CPT."
msgstr "Lista las taxonomías y sus términos para un tipo de contenido personalizado concreto."

#: enable-abilities-for-mcp.php:1656
msgid "Assign Terms to CPT Item"
msgstr "Asignar términos a elemento de CPT"

#: enable-abilities-for-mcp.php:1657
msgid "Assign taxonomy terms to a CPT item. Can add to or replace existing terms."
msgstr "Asigna términos de taxonomía a un elemento de CPT. Puede añadir a los términos existentes o reemplazarlos."

#: enable-abilities-for-mcp.php:1660
#: includes/abilities.php:6616
msgid "Get Term Meta"
msgstr "Obtener metadatos de término"

#: enable-abilities-for-mcp.php:1661
msgid "Read any single term meta field by exact key, or all meta for a term. Requires edit_term capability."
msgstr "Lee un campo de metadato de un término por clave exacta, o todos los metadatos del término. Requiere la capacidad edit_term."

#: enable-abilities-for-mcp.php:1664
#: includes/abilities.php:6718
msgid "Update Term Meta"
msgstr "Actualizar metadato de término"

#: enable-abilities-for-mcp.php:1665
msgid "Write any term meta field by exact key. Requires edit_term capability."
msgstr "Escribe cualquier campo de metadato de un término por clave exacta. Requiere la capacidad edit_term."

#: enable-abilities-for-mcp.php:1668
#: includes/abilities.php:6802
msgid "Update Term"
msgstr "Actualizar término"

#: enable-abilities-for-mcp.php:1669
msgid "Update a taxonomy term's core fields: name, slug, description, or parent. Requires edit_term capability."
msgstr "Actualiza los campos principales de un término de taxonomía: nombre, slug, descripción o superior. Requiere la capacidad edit_term."

#: enable-abilities-for-mcp.php:1674
msgid "JetEngine — Options Pages"
msgstr "JetEngine — Páginas de opciones"

#: enable-abilities-for-mcp.php:1675
msgid "Read and write JetEngine Options Pages fields. Requires JetEngine with the Options Pages module enabled."
msgstr "Lee y escribe campos de las páginas de opciones de JetEngine. Requiere JetEngine con el módulo Options Pages activado."

#: enable-abilities-for-mcp.php:1681
#: includes/abilities.php:8587
msgid "List Options Pages"
msgstr "Listar páginas de opciones"

#: enable-abilities-for-mcp.php:1682
msgid "List all registered JetEngine Options Pages with their field schema (no values)."
msgstr "Lista todas las páginas de opciones de JetEngine registradas con su esquema de campos (sin valores)."

#: enable-abilities-for-mcp.php:1686
#: includes/abilities.php:8663
msgid "Get Options Page"
msgstr "Obtener página de opciones"

#: enable-abilities-for-mcp.php:1687
msgid "Return all fields with their current stored values for a given Options Page slug."
msgstr "Devuelve todos los campos con sus valores almacenados para un slug de página de opciones dado."

#: enable-abilities-for-mcp.php:1691
#: includes/abilities.php:8773
msgid "Update Options Page Field"
msgstr "Actualizar campo de página de opciones"

#: enable-abilities-for-mcp.php:1692
msgid "Write a new value to a single field of a JetEngine Options Page. Destructive — opt-in required."
msgstr "Escribe un nuevo valor en un campo individual de una página de opciones de JetEngine. Destructiva — requiere activación manual."

#: enable-abilities-for-mcp.php:1698
#: includes/abilities.php:849
msgid "JetEngine Query Builder"
msgstr "JetEngine Query Builder"

#: enable-abilities-for-mcp.php:1699
msgid "List, read, and update JetEngine Query Builder queries. Complements JetEngine's own native \"Add Query\" MCP tool, which has no edit/get/list equivalent. Requires JetEngine with the Query Builder module."
msgstr "Lista, lee y actualiza consultas de JetEngine Query Builder. Complementa la herramienta MCP nativa \"Add Query\" de JetEngine, que no tiene equivalente para editar, obtener o listar. Requiere JetEngine con el módulo Query Builder."

#: enable-abilities-for-mcp.php:1705
msgid "List Queries"
msgstr "Listar consultas"

#: enable-abilities-for-mcp.php:1706
msgid "List all Query Builder queries with id, name, and query type."
msgstr "Lista todas las consultas de Query Builder con ID, nombre y tipo de consulta."

#: enable-abilities-for-mcp.php:1710
msgid "Get Query"
msgstr "Obtener consulta"

#: enable-abilities-for-mcp.php:1711
msgid "Get the full settings of one query by id."
msgstr "Obtiene la configuración completa de una consulta por ID."

#: enable-abilities-for-mcp.php:1715
msgid "Update Query"
msgstr "Actualizar consulta"

#: enable-abilities-for-mcp.php:1716
msgid "Update an existing query's name, type, or arguments. Destructive — opt-in required."
msgstr "Actualiza el nombre, el tipo o los argumentos de una consulta existente. Destructiva — requiere activación manual."

#: enable-abilities-for-mcp.php:1722
#: includes/abilities.php:817
msgid "Elementor"
msgstr "Elementor"

#: enable-abilities-for-mcp.php:1723
msgid "Read and edit Elementor page/template data. Requires Elementor (Pro for post title, JetEngine for meta fields)."
msgstr "Lee y edita datos de páginas y plantillas de Elementor. Requiere Elementor (Pro para el título de la entrada, JetEngine para campos meta)."

#: enable-abilities-for-mcp.php:1728
msgid "Bind Dynamic Field"
msgstr "Vincular campo dinámico"

#: enable-abilities-for-mcp.php:1729
msgid "Bind an Elementor widget setting to a dynamic tag (post title or a JetEngine/meta field). Edits _elementor_data server-side. Destructive — opt-in required."
msgstr "Vincula un ajuste de un widget de Elementor a una etiqueta dinámica (título de la entrada o un campo meta/JetEngine). Edita _elementor_data en el servidor. Destructiva — requiere activación manual."

#: enable-abilities-for-mcp.php:1733
msgid "Get Structure"
msgstr "Obtener estructura"

#: enable-abilities-for-mcp.php:1734
msgid "Read-only compact tree of an Elementor page (element ids, types, text preview)."
msgstr "Árbol compacto de solo lectura de una página de Elementor (IDs de elementos, tipos y vista previa del texto)."

#: enable-abilities-for-mcp.php:1738
msgid "Update Element"
msgstr "Actualizar elemento"

#: enable-abilities-for-mcp.php:1739
msgid "Edit the settings of an Elementor element by id (static content/styles). Destructive."
msgstr "Edita los ajustes de un elemento de Elementor por ID (contenido estático o estilos). Destructiva."

#: enable-abilities-for-mcp.php:1745
#: includes/abilities.php:825
msgid "LearnDash"
msgstr "LearnDash"

#: enable-abilities-for-mcp.php:1746
msgid "Query and manage LearnDash courses, user progress, quiz results, and enrollments. Requires LearnDash (SFWD_LMS class)."
msgstr "Consulta y gestiona cursos, progreso de usuarios, resultados de cuestionarios e inscripciones de LearnDash. Requiere LearnDash (clase SFWD_LMS)."

#: enable-abilities-for-mcp.php:1752
msgid "Get Courses"
msgstr "Obtener cursos"

#: enable-abilities-for-mcp.php:1753
msgid "List published LearnDash courses with title, slug, permalink, and enrolled user count. Supports pagination and title search."
msgstr "Lista los cursos publicados de LearnDash con título, slug, enlace permanente y número de usuarios inscritos. Admite paginación y búsqueda por título."

#: enable-abilities-for-mcp.php:1757
#: enable-abilities-for-mcp.php:1806
msgid "Get Single Course"
msgstr "Obtener un curso"

#: enable-abilities-for-mcp.php:1758
msgid "Full course detail: title, description, permalink, ordered lessons with topics, and course-level quizzes."
msgstr "Detalle completo del curso: título, descripción, enlace permanente, lecciones ordenadas con sus temas y cuestionarios a nivel de curso."

#: enable-abilities-for-mcp.php:1762
#: enable-abilities-for-mcp.php:1811
msgid "Get User Progress"
msgstr "Obtener progreso del usuario"

#: enable-abilities-for-mcp.php:1763
msgid "User progress in a specific course: enrollment status, steps completed/total, percentage, and completion flag."
msgstr "Progreso del usuario en un curso específico: estado de inscripción, pasos completados/totales, porcentaje e indicador de finalización."

#: enable-abilities-for-mcp.php:1767
#: enable-abilities-for-mcp.php:1816
msgid "Get Quiz Results"
msgstr "Obtener resultados de cuestionarios"

#: enable-abilities-for-mcp.php:1768
msgid "Quiz attempt history for a user (optionally filtered by quiz ID): score, total, pass/fail, and timestamp. Sorted newest first."
msgstr "Historial de intentos de cuestionarios de un usuario (con filtro opcional por ID de cuestionario): puntuación, total, aprobado/suspendido y fecha. Ordenado del más reciente al más antiguo."

#: enable-abilities-for-mcp.php:1772
#: enable-abilities-for-mcp.php:1821
msgid "Enroll User"
msgstr "Inscribir usuario"

#: enable-abilities-for-mcp.php:1773
msgid "Enroll a user in a LearnDash course. Requires manage_options. Opt-in required — disabled by default."
msgstr "Inscribe a un usuario en un curso de LearnDash. Requiere manage_options. Requiere activación manual — desactivada por defecto."

#: enable-abilities-for-mcp.php:1777
#: enable-abilities-for-mcp.php:1826
msgid "Unenroll User"
msgstr "Anular inscripción"

#: enable-abilities-for-mcp.php:1778
msgid "Remove a user's access to a LearnDash course. Requires manage_options. Destructive — opt-in required."
msgstr "Retira el acceso de un usuario a un curso de LearnDash. Requiere manage_options. Destructiva — requiere activación manual."

#: enable-abilities-for-mcp.php:1784
#: includes/abilities.php:833
msgid "Tutor LMS"
msgstr "Tutor LMS"

#: enable-abilities-for-mcp.php:1785
msgid "Query and manage Tutor LMS courses, lesson videos, user progress, quiz results, and enrollments. Requires Tutor LMS (tutor_utils())."
msgstr "Consulta y gestiona cursos, videos de lecciones, progreso de usuarios, resultados de cuestionarios e inscripciones de Tutor LMS. Requiere Tutor LMS (tutor_utils())."

#: enable-abilities-for-mcp.php:1791
msgid "Get Lesson Video"
msgstr "Obtener video de la lección"

#: enable-abilities-for-mcp.php:1792
msgid "Reads a Tutor LMS lesson's video source configuration (source type, value, and runtime)."
msgstr "Lee la configuración de la fuente de video de una lección de Tutor LMS (tipo de fuente, valor y duración)."

#: enable-abilities-for-mcp.php:1796
msgid "Update Lesson Video"
msgstr "Actualizar video de la lección"

#: enable-abilities-for-mcp.php:1797
msgid "Sets a Tutor LMS lesson's video source using Tutor's own storage function, avoiding the string-only limitation of the generic Update Post Meta ability."
msgstr "Establece la fuente de video de una lección de Tutor LMS usando la función de almacenamiento propia de Tutor, evitando la limitación de solo-texto de la capacidad genérica Actualizar metadato de entrada."

#: enable-abilities-for-mcp.php:1801
msgid "List Courses"
msgstr "Listar cursos"

#: enable-abilities-for-mcp.php:1802
msgid "List published Tutor LMS courses with title, slug, permalink, and enrolled user count. Supports pagination and title search."
msgstr "Lista los cursos publicados de Tutor LMS con título, slug, enlace permanente y número de usuarios inscritos. Admite paginación y búsqueda por título."

#: enable-abilities-for-mcp.php:1807
msgid "Full course detail: title, description, permalink, and topics with ordered lessons, quizzes, and assignments."
msgstr "Detalle completo del curso: título, descripción, enlace permanente y temas con sus lecciones, cuestionarios y tareas en orden."

#: enable-abilities-for-mcp.php:1812
msgid "User progress in a specific course: enrollment status/date, steps completed/total, and completion percentage."
msgstr "Progreso de un usuario en un curso concreto: estado y fecha de inscripción, pasos completados/totales y porcentaje de finalización."

#: enable-abilities-for-mcp.php:1817
msgid "Quiz attempt history for a user (optionally filtered by quiz ID): score, total, pass/fail, and timestamps. Sorted newest first."
msgstr "Historial de intentos de cuestionarios de un usuario (opcionalmente filtrado por ID de cuestionario): puntuación, total, aprobado/suspendido y fechas. Ordenado del más reciente al más antiguo."

#: enable-abilities-for-mcp.php:1822
msgid "Enroll a user in a Tutor LMS course. Requires manage_options. Opt-in required — disabled by default."
msgstr "Inscribe a un usuario en un curso de Tutor LMS. Requiere manage_options. Requiere activación manual — desactivada por defecto."

#: enable-abilities-for-mcp.php:1827
msgid "Cancel a user's enrollment in a Tutor LMS course. Requires manage_options. Destructive — opt-in required."
msgstr "Cancela la inscripción de un usuario en un curso de Tutor LMS. Requiere manage_options. Destructiva — requiere activación manual."

#: enable-abilities-for-mcp.php:1833
msgid "AI — Agent Readiness (llms.txt)"
msgstr "IA — Preparación para agentes (llms.txt)"

#: enable-abilities-for-mcp.php:1834
msgid "Read, validate, and manage the site llms.txt file — the AI-crawler guidance file audited by Lighthouse \"Agentic Browsing\". Integrates with SEOPress Pro when active; otherwise serves a virtual /llms.txt directly."
msgstr "Lee, valida y gestiona el archivo llms.txt del sitio — el archivo de guía para rastreadores de IA que audita Lighthouse en \"Agentic Browsing\". Se integra con SEOPress Pro cuando está activo; en caso contrario sirve un /llms.txt virtual directamente."

#: enable-abilities-for-mcp.php:1838
#: includes/abilities.php:10632
msgid "Get llms.txt"
msgstr "Obtener llms.txt"

#: enable-abilities-for-mcp.php:1839
msgid "Fetch the site llms.txt, detect which component serves it, and validate it against the llmstxt.org spec with actionable issues."
msgstr "Obtiene el llms.txt del sitio, detecta qué componente lo sirve y lo valida contra la especificación de llmstxt.org con incidencias accionables."

#: enable-abilities-for-mcp.php:1842
#: includes/abilities.php:10746
msgid "Update llms.txt"
msgstr "Actualizar llms.txt"

#: enable-abilities-for-mcp.php:1843
msgid "Write the llms.txt content (SEOPress Pro option when active, or a virtual file served by this plugin). Requires manage_options. Opt-in."
msgstr "Escribe el contenido del llms.txt (en la opción de SEOPress Pro si está activo, o como archivo virtual servido por este plugin). Requiere manage_options. Requiere activación manual."

#: enable-abilities-for-mcp.php:1849
#: includes/abilities.php:841
msgid "Accessibility (WCAG)"
msgstr "Accesibilidad (WCAG)"

#: enable-abilities-for-mcp.php:1850
msgid "Detect accessibility issues WordPress can diagnose server-side. Does not replace a browser-based audit (e.g. Lighthouse) for color contrast, ARIA, or keyboard navigation."
msgstr "Detecta los problemas de accesibilidad que WordPress puede diagnosticar desde el servidor. No sustituye una auditoría en el navegador (p. ej., Lighthouse) para contraste de color, ARIA o navegación con teclado."

#: enable-abilities-for-mcp.php:1854
#: includes/abilities.php:11177
msgid "Get Accessibility Snapshot"
msgstr "Obtener resumen de accesibilidad"

#: enable-abilities-for-mcp.php:1855
msgid "Scan the media library for images missing alt text (WCAG 1.1.1), paginated."
msgstr "Analiza la biblioteca de medios en busca de imágenes sin texto alternativo (WCAG 1.1.1), con paginación."

#: enable-abilities-for-mcp.php:1860
#: includes/abilities.php:857
msgid "FSE Block Templates"
msgstr "Plantillas de bloques FSE"

#: enable-abilities-for-mcp.php:1861
msgid "Inspect and edit Full Site Editing (FSE/Gutenberg) block templates and template parts. Only available when the active theme supports block templates."
msgstr "Inspecciona y edita plantillas de bloques y partes de plantilla de la edición completa del sitio (FSE/Gutenberg). Solo disponible cuando el tema activo admite plantillas de bloques."

#: enable-abilities-for-mcp.php:1867
msgid "List Templates"
msgstr "Listar plantillas"

#: enable-abilities-for-mcp.php:1868
msgid "List all wp_template and wp_template_part entries for the active theme, with slug, title, area, and whether each is a theme default or a user-edited override."
msgstr "Lista todas las entradas wp_template y wp_template_part del tema activo, con slug, título, área y si cada una es la predeterminada del tema o una versión editada por el usuario."

#: enable-abilities-for-mcp.php:1872
msgid "Get Template"
msgstr "Obtener plantilla"

#: enable-abilities-for-mcp.php:1873
msgid "Get the full block markup for one template or template part by slug."
msgstr "Obtiene el marcado de bloques completo de una plantilla o parte de plantilla por slug."

#: enable-abilities-for-mcp.php:1877
msgid "Update Template"
msgstr "Actualizar plantilla"

#: enable-abilities-for-mcp.php:1878
msgid "Write new block markup to a template or template part. Requires edit_theme_options. A header/footer edit affects every page that uses it — opt-in required, disabled by default."
msgstr "Escribe nuevo marcado de bloques en una plantilla o parte de plantilla. Requiere edit_theme_options. Editar una cabecera o un pie de página afecta a todas las páginas que lo usan — requiere activación manual, desactivada por defecto."

#: enable-abilities-for-mcp.php:2033
msgid "No Custom Post Types detected on this site. These abilities will become available when a plugin or theme registers custom post types (e.g., WooCommerce, ACF, JetEngine)."
msgstr "No se han detectado tipos de contenido personalizados en este sitio. Estas capacidades estarán disponibles cuando un plugin o tema registre tipos de contenido personalizados (p. ej., WooCommerce, ACF, JetEngine)."

#: enable-abilities-for-mcp.php:2053
msgid "Rank Math SEO plugin is not active. These abilities require Rank Math to function."
msgstr "El plugin Rank Math SEO no está activo. Estas capacidades requieren Rank Math para funcionar."

#: enable-abilities-for-mcp.php:2069
msgid "SEOPress plugin is not active. These abilities require SEOPress to function."
msgstr "El plugin SEOPress no está activo. Estas capacidades requieren SEOPress para funcionar."

#: enable-abilities-for-mcp.php:2085
msgid "Yoast SEO plugin is not active. These abilities require Yoast SEO to function."
msgstr "El plugin Yoast SEO no está activo. Estas capacidades requieren Yoast SEO para funcionar."

#: enable-abilities-for-mcp.php:2101
msgid "WooCommerce is not active. These abilities require WooCommerce to function."
msgstr "WooCommerce no está activo. Estas capacidades requieren WooCommerce para funcionar."

#: enable-abilities-for-mcp.php:2117
msgid "The Events Calendar plugin is not active. These abilities require The Events Calendar to function."
msgstr "El plugin The Events Calendar no está activo. Estas capacidades requieren The Events Calendar para funcionar."

#: enable-abilities-for-mcp.php:2134
msgid "Code Snippets plugin is not active. This ability requires Code Snippets 2.x or 3.x to function."
msgstr "El plugin Code Snippets no está activo. Esta capacidad requiere Code Snippets 2.x o 3.x para funcionar."

#: enable-abilities-for-mcp.php:2140
msgid "Security: snippets are always saved as inactive and must be activated manually from wp-admin › Snippets. Enable only in trusted environments. Requires manage_options."
msgstr "Seguridad: los fragmentos siempre se guardan como inactivos y deben activarse manualmente desde wp-admin › Fragmentos. Habilitar solo en entornos de confianza. Requiere manage_options."

#: enable-abilities-for-mcp.php:2158
msgid "No multilanguage plugin detected. These abilities require Polylang, WPML, or Linguator AI to function."
msgstr "No se ha detectado ningún plugin multiidioma. Estas capacidades requieren Polylang, WPML o Linguator AI para funcionar."

#: enable-abilities-for-mcp.php:2173
msgid "JetEngine is active but the Options Pages module is not enabled. Enable it under JetEngine › Settings › Modules."
msgstr "JetEngine está activo pero el módulo Options Pages no está activado. Actívalo en JetEngine › Ajustes › Módulos."

#: enable-abilities-for-mcp.php:2174
msgid "JetEngine plugin is not active. These abilities require JetEngine with the Options Pages module enabled."
msgstr "El plugin JetEngine no está activo. Estas capacidades requieren JetEngine con el módulo Options Pages activado."

#: enable-abilities-for-mcp.php:2194
msgid "LearnDash is not active. These abilities require LearnDash (SFWD_LMS) to function."
msgstr "LearnDash no está activo. Estas capacidades requieren LearnDash (SFWD_LMS) para funcionar."

#: enable-abilities-for-mcp.php:2210
msgid "Tutor LMS is not active. These abilities require Tutor LMS to function."
msgstr "Tutor LMS no está activo. Estas capacidades requieren Tutor LMS para funcionar."

#: enable-abilities-for-mcp.php:2226
msgid "JetEngine is active but the Query Builder module is not enabled. Enable it under JetEngine › Settings › Modules."
msgstr "JetEngine está activo pero el módulo Query Builder no está activado. Actívalo en JetEngine › Ajustes › Módulos."

#: enable-abilities-for-mcp.php:2227
msgid "JetEngine plugin is not active. These abilities require JetEngine with the Query Builder module enabled."
msgstr "El plugin JetEngine no está activo. Estas capacidades requieren JetEngine con el módulo Query Builder activado."

#: enable-abilities-for-mcp.php:2248
msgid "The active theme does not support block templates (Full Site Editing). These abilities require a block-based theme."
msgstr "El tema activo no admite plantillas de bloques (edición completa del sitio). Estas capacidades requieren un tema de bloques."

#: includes/abilities.php:169
msgid "This content type has dedicated abilities. Use the specific abilities for posts, pages, or media instead."
msgstr "Este tipo de contenido tiene capacidades dedicadas. Usa las capacidades específicas para entradas, páginas o medios."

#: includes/abilities.php:176
msgid "The specified content type does not exist."
msgstr "El tipo de contenido especificado no existe."

#: includes/abilities.php:186
msgid "This content type is not publicly accessible."
msgstr "Este tipo de contenido no es de acceso público."

#. translators: %s: requested post status
#: includes/abilities.php:332
#, php-format
msgid "Unknown post status \"%s\". Use \"any\" or a status registered on this site."
msgstr "Estado de entrada desconocido: «%s». Usa \"any\" o un estado registrado en este sitio."

#. translators: %s: meta key
#: includes/abilities.php:364
#, php-format
msgid "The meta key \"%s\" is reserved by WordPress and cannot be written."
msgstr "La clave de metadato «%s» está reservada por WordPress y no se puede escribir."

#. translators: %s: meta key
#: includes/abilities.php:379
#, php-format
msgid "The meta key \"%s\" is protected and you are not allowed to write it."
msgstr "La clave de metadato «%s» está protegida y no tienes permiso para escribirla."

#: includes/abilities.php:426
msgid "meta_value needs a meta_key."
msgstr "meta_value requiere meta_key."

#: includes/abilities.php:433
msgid "You do not have permission to filter content by meta."
msgstr "No tienes permiso para filtrar contenido por metadatos."

#. translators: %s: meta key
#: includes/abilities.php:441
#, php-format
msgid "The meta key \"%s\" is protected and you are not allowed to filter by it."
msgstr "La clave de metadato «%s» está protegida y no tienes permiso para filtrar por ella."

#. translators: %s: term name
#: includes/abilities.php:483
#, php-format
msgid "The term \"%s\" does not exist and you are not allowed to create terms in this taxonomy."
msgstr "El término «%s» no existe y no tienes permiso para crear términos en esta taxonomía."

#. translators: %s: ability name
#: includes/abilities.php:714
#, php-format
msgid "The ability \"%s\" has been disabled. Enable it in the plugin settings before calling it."
msgstr "La capacidad \"%s\" está desactivada. Actívala en los ajustes del plugin antes de usarla."

#: includes/abilities.php:745
msgid "Content Management"
msgstr "Gestión de contenido"

#: includes/abilities.php:746
msgid "Abilities to create, read, update, and delete blog content."
msgstr "Capacidades para crear, leer, actualizar y eliminar contenido del blog."

#: includes/abilities.php:753
msgid "User Management"
msgstr "Gestión de usuarios"

#: includes/abilities.php:754
msgid "Abilities to query site user information."
msgstr "Capacidades para consultar la información de los usuarios del sitio."

#: includes/abilities.php:762
msgid "Abilities to get general information and site statistics."
msgstr "Capacidades para obtener información general y estadísticas del sitio."

#: includes/abilities.php:770
msgid "Abilities to discover and manage custom post types registered by plugins or themes."
msgstr "Capacidades para descubrir y gestionar los tipos de contenido personalizados registrados por plugins o temas."

#: includes/abilities.php:778
msgid "Abilities to inspect and manage navigation menus, their items, and theme locations."
msgstr "Capacidades para inspeccionar y gestionar los menús de navegación, sus elementos y las ubicaciones del tema."

#: includes/abilities.php:786
msgid "Abilities to manage WooCommerce products, orders, and customers."
msgstr "Capacidades para gestionar productos, pedidos y clientes de WooCommerce."

#: includes/abilities.php:794
msgid "Abilities to list, get, create, and update events from The Events Calendar."
msgstr "Capacidades para listar, obtener, crear y actualizar eventos de The Events Calendar."

#: includes/abilities.php:802
msgid "Abilities to manage post languages and translation groups via Polylang or WPML."
msgstr "Capacidades para gestionar los idiomas de las entradas y los grupos de traducción mediante Polylang o WPML."

#: includes/abilities.php:809
msgid "JetEngine Options Pages"
msgstr "Páginas de opciones de JetEngine"

#: includes/abilities.php:810
msgid "Abilities to read and write JetEngine Options Pages fields. Requires JetEngine with the Options Pages module enabled."
msgstr "Capacidades para leer y escribir campos de las páginas de opciones de JetEngine. Requiere JetEngine con el módulo Options Pages activado."

#: includes/abilities.php:818
msgid "Abilities to read and edit Elementor page and template data."
msgstr "Capacidades para leer y editar datos de páginas y plantillas de Elementor."

#: includes/abilities.php:826
msgid "Abilities to manage LearnDash courses, lessons, quizzes, and user enrollments."
msgstr "Capacidades para gestionar cursos, lecciones, cuestionarios e inscripciones de LearnDash."

#: includes/abilities.php:834
msgid "Abilities to manage Tutor LMS courses, lesson videos, user progress, quiz results, and enrollments."
msgstr "Capacidades para gestionar cursos, videos de lecciones, progreso de usuarios, resultados de cuestionarios e inscripciones de Tutor LMS."

#: includes/abilities.php:842
msgid "Abilities to detect and help fix accessibility issues WordPress can diagnose server-side."
msgstr "Capacidades para detectar y ayudar a corregir los problemas de accesibilidad que WordPress puede diagnosticar desde el servidor."

#: includes/abilities.php:850
msgid "Abilities to list, read, and update JetEngine Query Builder queries."
msgstr "Capacidades para listar, leer y actualizar consultas de JetEngine Query Builder."

#: includes/abilities.php:858
msgid "Abilities to list, read, and edit Full Site Editing block templates and template parts."
msgstr "Capacidades para listar, leer y editar plantillas de bloques y partes de plantilla de la edición completa del sitio."

#: includes/abilities.php:889
msgid "Retrieves a list of blog posts with optional filters by status, category, count, and order."
msgstr "Recupera una lista de entradas del blog con filtros opcionales por estado, categoría, cantidad y orden."

#: includes/abilities.php:1056
msgid "Retrieves all details of a specific post by ID, including full content, metadata, and featured image."
msgstr "Recupera todos los detalles de una entrada específica por ID, incluyendo el contenido completo, los metadatos y la imagen destacada."

#: includes/abilities.php:1144
msgid "Retrieves all details of a specific page by ID, including full content, template, hierarchy, and SEO metadata."
msgstr "Recupera todos los detalles de una página específica por ID, incluyendo el contenido completo, la plantilla, la jerarquía y los metadatos SEO."

#: includes/abilities.php:1227
msgid "Retrieves all blog categories with their ID, name, slug, description, and post count."
msgstr "Recupera todas las categorías del blog con su ID, nombre, slug, descripción y recuento de entradas."

#: includes/abilities.php:1291
msgid "Retrieves all blog tags with their ID, name, slug, and post count."
msgstr "Recupera todas las etiquetas del blog con su ID, nombre, slug y recuento de entradas."

#: includes/abilities.php:1359
msgid "Retrieves site pages with their title, status, content, and hierarchy (parent/child)."
msgstr "Recupera las páginas del sitio con su título, estado, contenido y jerarquía (padre/hijo)."

#: includes/abilities.php:1450
msgid "Retrieves blog comments with optional filters by status, post, and count. Useful for moderation and analysis."
msgstr "Recupera los comentarios del blog con filtros opcionales por estado, entrada y cantidad. Útil para moderación y análisis."

#: includes/abilities.php:1539
msgid "Retrieves media library files (images, videos, documents) with filters by MIME type and search."
msgstr "Recupera los archivos de la biblioteca de medios (imágenes, vídeos, documentos) con filtros por tipo MIME y búsqueda."

#: includes/abilities.php:1626
msgid "Retrieves the list of site users with their ID, name, email, and role. Useful for assigning post authors."
msgstr "Recupera la lista de usuarios del sitio con su ID, nombre, correo electrónico y rol. Útil para asignar autores a entradas."

#: includes/abilities.php:1696
msgid "Creates a new blog post. Accepts title, HTML content, excerpt, categories, tags, featured image, and status. Defaults to draft."
msgstr "Crea una nueva entrada en el blog. Acepta título, contenido HTML, extracto, categorías, etiquetas, imagen destacada y estado. Por defecto, se crea como borrador."

#: includes/abilities.php:1888
msgid "Updates an existing post. Only the provided fields are modified, others remain unchanged."
msgstr "Actualiza una entrada existente. Solo se modifican los campos proporcionados; los demás permanecen sin cambios."

#: includes/abilities.php:2031
msgid "Sends a post to trash or permanently deletes it. Defaults to trash."
msgstr "Envía una entrada a la papelera o la elimina de forma permanente. Por defecto, va a la papelera."

#: includes/abilities.php:2099
msgid "Creates a new blog category with name, slug, description, and parent category (optional)."
msgstr "Crea una nueva categoría de blog con nombre, slug, descripción y categoría padre (opcional)."

#: includes/abilities.php:2182
msgid "Creates a new blog tag with name, slug, and description."
msgstr "Crea una nueva etiqueta de blog con nombre, slug y descripción."

#: includes/abilities.php:2257
msgid "Creates a new WordPress page with title, content, status, and parent page (for hierarchy)."
msgstr "Crea una nueva página de WordPress con título, contenido, estado y página padre (para jerarquía)."

#: includes/abilities.php:2354
msgid "Changes a comment status: approve, hold, mark as spam, or send to trash."
msgstr "Cambia el estado de un comentario: aprobar, retener, marcar como spam o enviar a la papelera."

#: includes/abilities.php:2436
msgid "Replies to an existing comment on a post or page. The reply is published as the current authenticated user."
msgstr "Responde a un comentario existente en una entrada o página. La respuesta se publica como el usuario autenticado actual."

#: includes/abilities.php:2515
msgid "Updates an existing comment. Allows changing the content, author name, author email, and the WordPress user associated with the comment."
msgstr "Actualiza un comentario existente. Permite cambiar el contenido, el nombre del autor, el correo electrónico del autor y el usuario de WordPress asociado al comentario."

#: includes/abilities.php:2636
msgid "Downloads an image from an external URL and registers it in the WordPress media library. Optionally assigns it as featured image for a post. Returns the attachment ID and local URL."
msgstr "Descarga una imagen de una URL externa y la registra en la biblioteca de medios de WordPress. Opcionalmente, la asigna como imagen destacada de una entrada. Devuelve el ID del adjunto y la URL local."

#: includes/abilities.php:2713
#: includes/abilities.php:7942
#: includes/multilanguage.php:998
msgid "You do not have permission to edit this post."
msgstr "No tienes permiso para editar esta entrada."

#: includes/abilities.php:2808
msgid "Creates an exact copy of any post, page, or custom post type item — including all post meta (ACF, SEO, featured image) and taxonomy terms. The duplicate is saved as draft by default. Returns the new post ID and edit URL."
msgstr "Crea una copia exacta de cualquier entrada, página o elemento de tipo de contenido personalizado — incluyendo todos los meta de la publicación (ACF, SEO, imagen destacada) y términos de taxonomía. El duplicado se guarda como borrador por defecto. Devuelve el ID de la nueva publicación y la URL de edición."

#: includes/abilities.php:2845
msgid "Post not found or type cannot be duplicated."
msgstr "Publicación no encontrada o tipo no puede ser duplicado."

#: includes/abilities.php:2848
#: includes/abilities.php:7692
#: includes/abilities.php:9674
#: includes/multilanguage.php:895
msgid "You do not have permission to read this post."
msgstr "No tienes permiso para leer esta entrada."

#: includes/abilities.php:2851
#: includes/abilities.php:5853
#: includes/multilanguage.php:945
msgid "You do not have permission to create items of this type."
msgstr "No tienes permiso para crear elementos de este tipo."

#: includes/abilities.php:2944
msgid "Retrieves all Rank Math SEO metadata for a post or page: title, description, keywords, robots, advanced robots, Open Graph, Twitter Card, schema, breadcrumb, cornerstone, and SEO score."
msgstr "Recupera todos los metadatos SEO de Rank Math para una entrada o página: título, descripción, palabras clave, robots, robots avanzados, Open Graph, Twitter Card, esquema, miga de pan, piedra angular y puntuación SEO."

#: includes/abilities.php:3069
msgid "Updates Rank Math SEO metadata on a post or page (rank_math_focus_keyword, rank_math_title, rank_math_description, etc). Use this ability to set or change the focus keyword, SEO title, meta description, canonical URL, robots, Open Graph, Twitter Card, breadcrumb, schema snippet, cornerstone, and pillar content. Only the provided fields are modified."
msgstr "Actualiza los metadatos SEO de Rank Math en una entrada o página (rank_math_focus_keyword, rank_math_title, rank_math_description, etc.). Usa esta capacidad para establecer o cambiar la palabra clave principal, el título SEO, la metadescripción, la URL canónica, los robots, Open Graph, Twitter Card, la miga de pan, el fragmento de esquema, la piedra angular y el contenido pilar. Solo se modifican los campos proporcionados."

#: includes/abilities.php:3352
msgid "Writes a structured-data schema block (e.g. FAQPage, Article, Product) to a Rank Math schema meta key. The schema_data object is sanitized and stored as a PHP-serialized array, exactly as Rank Math expects, so it renders as JSON-LD in <head>. Use this to add or replace a schema block on any post or page."
msgstr "Escribe un bloque de esquema de datos estructurados (p. ej., FAQPage, Article, Product) en la clave meta de esquema de Rank Math. El objeto schema_data se sanea y almacena como un array serializado en PHP, tal y como Rank Math lo espera, de modo que se muestre como JSON-LD en el <head>. Úsalo para añadir o reemplazar un bloque de esquema en cualquier entrada o página."

#: includes/abilities.php:3360
msgid "ID of the post or page to update."
msgstr "ID de la entrada o página a actualizar."

#: includes/abilities.php:3364
msgid "Schema type suffix used as the Rank Math meta key name (rank_math_schema_{type}). Examples: FAQPage, Article, Product, VideoObject."
msgstr "Sufijo del tipo de esquema utilizado como nombre de la clave meta de Rank Math (rank_math_schema_{tipo}). Ejemplos: FAQPage, Article, Product, VideoObject."

#: includes/abilities.php:3375
msgid "The schema object to store. Must be a valid JSON object matching the chosen schema_type. String values are sanitized; URL fields (url, image, @context, sameAs, etc.) are run through esc_url_raw()."
msgstr "El objeto de esquema a almacenar. Debe ser un objeto JSON válido que coincida con el schema_type elegido. Los valores de cadena se sanean; los campos de URL (url, image, @context, sameAs, etc.) se procesan con esc_url_raw()."

#: includes/abilities.php:3430
msgid "Retrieves all SEOPress metadata for a post or page: title, description, focus keyword, robots directives, canonical URL, Open Graph, and Twitter Card."
msgstr "Recupera todos los metadatos de SEOPress para una entrada o página: título, descripción, palabra clave principal, directivas de robots, URL canónica, Open Graph y Twitter Card."

#: includes/abilities.php:3513
msgid "Updates SEOPress metadata on a post or page (_seopress_titles_title, _seopress_titles_desc, etc). Use this to set or change the SEO title, meta description, focus keyword, canonical URL, robots directives, and Open Graph / Twitter Card fields. Only the provided fields are modified."
msgstr "Actualiza los metadatos de SEOPress en una entrada o página (_seopress_titles_title, _seopress_titles_desc, etc.). Úsalo para establecer o cambiar el título SEO, la metadescripción, la palabra clave principal, la URL canónica, las directivas de robots y los campos de Open Graph/Twitter Card. Solo se modifican los campos proporcionados."

#: includes/abilities.php:3720
msgid "Retrieves the SEOPress content analysis for a post or page: every check (meta title, meta description, headings, internal links, structured data, image alt texts, etc.) with its impact level and recommendation text. Set refresh=true to run a fresh analysis of the rendered page before reading the results — recommended after updating content or metadata. Requires SEOPress 7.5+."
msgstr "Recupera el análisis de contenido de SEOPress para una entrada o página: cada comprobación (meta título, meta descripción, encabezados, enlaces internos, datos estructurados, textos alternativos de imágenes, etc.) con su nivel de impacto y el texto de la recomendación. Usa refresh=true para ejecutar un análisis nuevo de la página renderizada antes de leer los resultados — recomendado tras actualizar contenido o metadatos. Requiere SEOPress 7.5+."

#: includes/abilities.php:3889
msgid "Retrieves all Yoast SEO metadata for a post or page: title, description, focus keyphrase, canonical URL, robots (noindex/nofollow/advanced), Open Graph, and Twitter Card."
msgstr "Recupera todos los metadatos de Yoast SEO para una entrada o página: título, descripción, frase clave principal, URL canónica, robots (noindex/nofollow/avanzado), Open Graph y Twitter Card."

#: includes/abilities.php:3968
msgid "Updates Yoast SEO metadata on a post or page (_yoast_wpseo_title, _yoast_wpseo_metadesc, etc). Use this to set or change the SEO title, meta description, focus keyphrase, canonical URL, robots, and Open Graph / Twitter Card fields. Only the provided fields are modified."
msgstr "Actualiza los metadatos de Yoast SEO en una entrada o página (_yoast_wpseo_title, _yoast_wpseo_metadesc, etc.). Úsalo para establecer o cambiar el título SEO, la metadescripción, la frase clave principal, la URL canónica, los robots y los campos de Open Graph/Twitter Card. Solo se modifican los campos proporcionados."

#: includes/abilities.php:4163
msgid "Creates a PHP code snippet via the Code Snippets plugin. The snippet is always saved as inactive: activating it needs an administrator to confirm it in wp-admin (see ewpa/set-code-snippet-active). Validates PHP syntax, blocks dangerous functions, and fires an audit action hook after saving."
msgstr "Crea un fragmento de código PHP mediante el plugin Code Snippets. El fragmento siempre se guarda inactivo: activarlo requiere que un administrador lo confirme en wp-admin (consulta ewpa/set-code-snippet-active). Valida la sintaxis PHP, bloquea funciones peligrosas y dispara un hook de auditoría después de guardar."

#. translators: 1: snippet title, 2: snippet ID, 3: edit URL
#: includes/abilities.php:4263
#, php-format
msgid "Snippet '%1$s' (ID %2$d) created as INACTIVE. An administrator can activate it from %3$s, or you can request activation with ewpa/set-code-snippet-active."
msgstr "Fragmento «%1$s» (ID %2$d) creado como INACTIVO. Un administrador puede activarlo desde %3$s, o puedes solicitar su activación con ewpa/set-code-snippet-active."

#: includes/abilities.php:4286
msgid "Lists the snippets stored by the Code Snippets plugin with ID, name, description, type, scope, active state, tags, and priority. The code itself is not included; use ewpa/get-code-snippet to read one snippet. Snippets in the trash are skipped."
msgstr "Lista los fragmentos guardados por el plugin Code Snippets con ID, nombre, descripción, tipo, ámbito, estado, etiquetas y prioridad. No incluye el código; usa ewpa/get-code-snippet para leer un fragmento. Se omiten los fragmentos de la papelera."

#: includes/abilities.php:4373
msgid "Returns one snippet from the Code Snippets plugin by ID, including its code, type, scope, active state, tags, and priority."
msgstr "Devuelve un fragmento del plugin Code Snippets por ID, incluidos su código, tipo, ámbito, estado, etiquetas y prioridad."

#: includes/abilities.php:4434
msgid "Updates an existing PHP snippet of the Code Snippets plugin. Only the fields you pass are changed: name, description, code, scope, or tags. New code is validated like ewpa/create-code-snippet. If the snippet is active and its code changes, it is deactivated and needs a new, human-confirmed activation. Opt-in, disabled by default."
msgstr "Actualiza un fragmento PHP existente del plugin Code Snippets. Solo cambian los campos que envíes: nombre, descripción, código, ámbito o etiquetas. El código nuevo se valida igual que en ewpa/create-code-snippet. Si el fragmento está activo y su código cambia, se desactiva y necesita una nueva activación confirmada por una persona. Requiere activación manual, desactivada por defecto."

#: includes/abilities.php:4591
msgid "Deactivates a Code Snippets snippet immediately, or requests its activation. Activation is never done directly: it returns a confirmation link in wp-admin where an administrator reviews the code and approves or rejects it. Share that link with the site administrator. Opt-in, disabled by default."
msgstr "Desactiva de inmediato un fragmento de Code Snippets o solicita su activación. La activación nunca se hace directamente: devuelve un enlace de confirmación en wp-admin donde un administrador revisa el código y la aprueba o la rechaza. Comparte ese enlace con el administrador del sitio. Requiere activación manual, desactivada por defecto."

#: includes/abilities.php:4704
msgid "Fetches and parses the Yoast SEO sitemap index for this site, returning the list of all sitemap URLs and their last modification date."
msgstr "Obtiene y analiza el índice del mapa del sitio de Yoast SEO, devolviendo la lista de todas las URLs de los mapas del sitio y su fecha de última modificación."

#: includes/abilities.php:4794
msgid "Searches for text in a specific post content and replaces it with another. Useful for corrections and updates."
msgstr "Busca texto en el contenido de una entrada específica y lo reemplaza por otro. Útil para correcciones y actualizaciones."

#: includes/abilities.php:4883
msgid "Returns a summary with the total posts, pages, categories, tags, comments, and users of the site."
msgstr "Devuelve un resumen con el total de entradas, páginas, categorías, etiquetas, comentarios y usuarios del sitio."

#: includes/abilities.php:4958
msgid "Writes any post meta field by exact key. Use this when you know the exact meta key required by a specific SEO plugin or custom field (e.g. _genesis_title for The SEO Framework, _seopress_titles_title for SEOPress). Requires edit_post capability on the target post. Protected keys (leading underscore) require a site administrator, or an explicit authorization of that key for that user (register_post_meta auth_callback or the auth_post_meta_{key} filter)."
msgstr "Escribe cualquier metadato de entrada por su clave exacta. Úsala cuando conozcas la clave de metadato exacta que requiere un plugin de SEO o un campo personalizado concreto (p. ej., _genesis_title para The SEO Framework o _seopress_titles_title para SEOPress). Requiere la capacidad edit_post sobre la entrada de destino. Las claves protegidas (las que empiezan con guion bajo) requieren un administrador del sitio o una autorización explícita de esa clave para ese usuario (auth_callback de register_post_meta o el filtro auth_post_meta_{key})."

#: includes/abilities.php:5056
msgid "Reads any single post meta field by exact key. Useful for SEO plugins and custom fields not covered by dedicated sections (e.g. _genesis_title for The SEO Framework, _aioseo_title for AIOSEO). Requires edit_post capability on the target post."
msgstr "Lee cualquier campo de metadato de una entrada por clave exacta. Útil para plugins SEO y campos personalizados no cubiertos por secciones dedicadas (p. ej., _genesis_title para The SEO Framework, _aioseo_title para AIOSEO). Requiere la capacidad edit_post en la entrada de destino."

#: includes/abilities.php:5063
msgid "ID of the post or page to read."
msgstr "ID de la entrada o página a leer."

#: includes/abilities.php:5067
msgid "Exact meta key to read (e.g. _genesis_title, _aioseo_title, _custom_field)."
msgstr "Clave meta exacta a leer (p. ej., _genesis_title, _aioseo_title, _custom_field)."

#: includes/abilities.php:5128
msgid "Returns a list of all currently active plugins on the site, including name, version, and detected capabilities (multilanguage, SEO, WooCommerce, etc.)."
msgstr "Devuelve una lista de todos los plugins actualmente activos en el sitio, incluyendo nombre, versión y capacidades detectadas (multiidioma, SEO, WooCommerce, etc.)."

#: includes/abilities.php:5240
msgid "Purges the page cache for a single post/page (post_id) or the whole site (no post_id, requires manage_options). Detects the active cache plugin automatically: WP Rocket, LiteSpeed Cache, W3 Total Cache, WP Super Cache, or WP Fastest Cache. Call this after write abilities that modify post meta directly (update-seopress, update-post-meta, elementor-update-element, SEO fixes): those writes do not fire save_post, so cache plugins keep serving the OLD rendered HTML — audits and visitors see stale titles and meta descriptions until the cache is purged."
msgstr "Purga la caché de página de una entrada o página individual (post_id) o de todo el sitio (sin post_id, requiere manage_options). Detecta automáticamente el plugin de caché activo: WP Rocket, LiteSpeed Cache, W3 Total Cache, WP Super Cache o WP Fastest Cache. Llámala después de las capacidades de escritura que modifican post meta directamente (update-seopress, update-post-meta, elementor-update-element, correcciones SEO): esas escrituras no disparan save_post, por lo que los plugins de caché siguen sirviendo el HTML renderizado ANTIGUO — las auditorías y los visitantes ven títulos y meta descripciones obsoletos hasta que se purga la caché."

#: includes/abilities.php:5377
msgid "Lists all custom post types registered on the site, with their configuration, supported features, and associated taxonomies."
msgstr "Lista todos los tipos de contenido personalizados registrados en el sitio, con su configuración, características admitidas y taxonomías asociadas."

