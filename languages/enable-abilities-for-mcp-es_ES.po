#: enable-abilities-for-mcp.php:919
#: includes/abilities.php:409
msgid "Navigation Menus"
msgstr "Menús de navegación"

#: enable-abilities-for-mcp.php:920
msgid "Inspect and manage navigation menus, their items, and theme locations."
msgstr "Inspecciona y gestiona los menús de navegación, sus elementos y las ubicaciones del tema."

#: enable-abilities-for-mcp.php:924
#: includes/abilities.php:8388
msgid "Create Menu"
msgstr "Crear menú"

#: enable-abilities-for-mcp.php:925
msgid "Creates a new, empty navigation menu with the given name."
msgstr "Crea un nuevo menú de navegación vacío con el nombre indicado."

#: enable-abilities-for-mcp.php:928
#: includes/abilities.php:8446
msgid "List Menus"
msgstr "Listar menús"

#: enable-abilities-for-mcp.php:929
msgid "Lists every menu with its id, slug, and item count, plus the theme locations and which menu each one displays."
msgstr "Lista todos los menús con su id, slug y cantidad de elementos, además de las ubicaciones del tema y qué menú muestra cada una."

#: enable-abilities-for-mcp.php:932
#: includes/abilities.php:8500
msgid "Get Menu"
msgstr "Obtener menú"

#: enable-abilities-for-mcp.php:933
msgid "Returns every item of one menu with hierarchy, destination, and position."
msgstr "Devuelve todos los elementos de un menú con su jerarquía, destino y posición."

#: enable-abilities-for-mcp.php:936
#: includes/abilities.php:8564
msgid "Add Menu Item"
msgstr "Agregar elemento de menú"

#: enable-abilities-for-mcp.php:937
msgid "Adds a page, post, category, tag, or custom URL to a menu, with optional parent and position."
msgstr "Agrega una página, entrada, categoría, etiqueta o URL personalizada a un menú, con padre y posición opcionales."

#: enable-abilities-for-mcp.php:940
#: includes/abilities.php:8674
msgid "Update Menu Item"
msgstr "Actualizar elemento de menú"

#: enable-abilities-for-mcp.php:941
msgid "Updates the title, custom URL, parent, or position of one menu item."
msgstr "Actualiza el título, la URL personalizada, el padre o la posición de un elemento de menú."

#: enable-abilities-for-mcp.php:944
#: includes/abilities.php:8754
msgid "Remove Menu Item"
msgstr "Quitar elemento de menú"

#: enable-abilities-for-mcp.php:945
msgid "Permanently removes one item from a menu. Destructive — opt-in required."
msgstr "Quita permanentemente un elemento de un menú. Destructivo: requiere activación explícita."

#: enable-abilities-for-mcp.php:948
#: includes/abilities.php:8804
msgid "Assign Menu Location"
msgstr "Asignar ubicación de menú"

#: enable-abilities-for-mcp.php:949
msgid "Assigns a menu to a theme location. Changes site-wide navigation — opt-in required."
msgstr "Asigna un menú a una ubicación del tema. Cambia la navegación de todo el sitio: requiere activación explícita."

#: enable-abilities-for-mcp.php:952
#: includes/abilities.php:8869
msgid "Delete Menu"
msgstr "Eliminar menú"

#: enable-abilities-for-mcp.php:953
msgid "Permanently deletes a menu and all of its items. Destructive — opt-in required."
msgstr "Elimina permanentemente un menú y todos sus elementos. Destructivo: requiere activación explícita."

#: includes/abilities.php:410
msgid "Abilities to inspect and manage navigation menus, their items, and theme locations."
msgstr "Capacidades para inspeccionar y gestionar los menús de navegación, sus elementos y las ubicaciones del tema."

#: includes/abilities.php:8389
msgid "Creates a new, empty navigation menu with the given name. Use ewpa/add-menu-item to populate it and ewpa/assign-menu-location to display it."
msgstr "Crea un nuevo menú de navegación vacío con el nombre indicado. Usa ewpa/add-menu-item para agregarle elementos y ewpa/assign-menu-location para mostrarlo."

#: includes/abilities.php:8447
msgid "Lists every navigation menu with its id, slug, and item count, plus the theme menu locations and which menu each one displays."
msgstr "Lista todos los menús de navegación con su id, slug y cantidad de elementos, además de las ubicaciones de menú del tema y qué menú muestra cada una."

#: includes/abilities.php:8501
msgid "Returns every item of one menu with its hierarchy: id, title, url, target type (post_type, taxonomy, or custom), linked object, parent item, and position."
msgstr "Devuelve todos los elementos de un menú con su jerarquía: id, título, url, tipo de destino (post_type, taxonomía o personalizado), objeto vinculado, elemento padre y posición."

#: includes/abilities.php:8565
msgid "Adds an item to a menu: a page, post, or CPT item (object_id), a category or tag (taxonomy + object_id), or a custom URL. Supports parent item and position."
msgstr "Agrega un elemento a un menú: una página, entrada o elemento de un CPT (object_id), una categoría o etiqueta (taxonomía + object_id), o una URL personalizada. Admite elemento padre y posición."

#: includes/abilities.php:8675
msgid "Updates one menu item: title, custom URL, parent item, or position. Fields not provided keep their current value."
msgstr "Actualiza un elemento de menú: título, URL personalizada, elemento padre o posición. Los campos no enviados conservan su valor actual."

#: includes/abilities.php:8755
msgid "Permanently removes one item from a menu. Children of the removed item are kept and become top-level. Destructive — opt-in required."
msgstr "Quita permanentemente un elemento de un menú. Los hijos del elemento quitado se conservan y pasan a ser de primer nivel. Destructivo: requiere activación explícita."

#: includes/abilities.php:8805
msgid "Assigns a menu to a theme location (or clears the location with menu_id 0). Changes site-wide navigation. Opt-in required."
msgstr "Asigna un menú a una ubicación del tema (o la borra usando menu_id 0). Cambia la navegación de todo el sitio. Requiere activación explícita."

#: includes/abilities.php:8870
msgid "Permanently deletes a menu and all of its items, and clears it from any theme location it was assigned to. Destructive — opt-in required."
msgstr "Elimina permanentemente un menú y todos sus elementos, y lo borra de cualquier ubicación del tema a la que estuviera asignado. Destructivo: requiere activación explícita."

#: enable-abilities-for-mcp.php:1211
#: includes/abilities.php:465
msgid "Tutor LMS"
msgstr "Tutor LMS"

#: enable-abilities-for-mcp.php:1212
msgid "Read and update a Tutor LMS lesson's video source. Requires Tutor LMS (tutor_utils())."
msgstr "Lee y actualiza la fuente de video de una lección de Tutor LMS. Requiere Tutor LMS (tutor_utils())."

#: enable-abilities-for-mcp.php:1217
msgid "Get Lesson Video"
msgstr "Obtener video de la lección"

#: enable-abilities-for-mcp.php:1218
msgid "Reads a Tutor LMS lesson's video source configuration (source type, value, and runtime)."
msgstr "Lee la configuración de la fuente de video de una lección de Tutor LMS (tipo de fuente, valor y duración)."

#: enable-abilities-for-mcp.php:1222
msgid "Update Lesson Video"
msgstr "Actualizar video de la lección"

#: enable-abilities-for-mcp.php:1223
msgid "Sets a Tutor LMS lesson's video source using Tutor's own storage function, avoiding the string-only limitation of the generic Update Post Meta ability."
msgstr "Establece la fuente de video de una lección de Tutor LMS usando la función de almacenamiento propia de Tutor, evitando la limitación de solo-texto de la capacidad genérica Actualizar metadato de entrada."

#: enable-abilities-for-mcp.php:1564
msgid "Tutor LMS is not active. These abilities require Tutor LMS to function."
msgstr "Tutor LMS no está activo. Estas capacidades requieren Tutor LMS para funcionar."

#: includes/abilities.php:466
msgid "Abilities to read and update the video source of Tutor LMS lessons."
msgstr "Capacidades para leer y actualizar la fuente de video de las lecciones de Tutor LMS."

#: includes/abilities.php:7978
msgid "Tutor LMS: Get Lesson Video"
msgstr "Tutor LMS: Obtener video de la lección"

#: includes/abilities.php:7980
msgid "Reads the video source configuration of a Tutor LMS lesson (source type, source value, and runtime), via tutor_utils()->get_video(). Requires edit_post capability on the lesson."
msgstr "Lee la configuración de la fuente de video de una lección de Tutor LMS (tipo de fuente, valor de la fuente y duración), mediante tutor_utils()->get_video(). Requiere la capacidad edit_post sobre la lección."

#: includes/abilities.php:7987
#: includes/abilities.php:8045
msgid "Lesson post ID."
msgstr "ID de la entrada de la lección."

#: includes/abilities.php:8036
msgid "Tutor LMS: Update Lesson Video"
msgstr "Tutor LMS: Actualizar video de la lección"

#: includes/abilities.php:8038
msgid "Sets a Tutor LMS lesson's video source (external URL, YouTube, Vimeo, HTML5, or a third-party source such as Bunny.net) via tutor_utils()->update_video(), the same function Tutor's own editor uses. Always writes the video meta as a native PHP array, avoiding the string-only storage of ewpa/update-post-meta that Tutor cannot read back. Requires edit_post capability on the lesson."
msgstr "Establece la fuente de video de una lección de Tutor LMS (URL externa, YouTube, Vimeo, HTML5 o una fuente de terceros como Bunny.net) mediante tutor_utils()->update_video(), la misma función que usa el propio editor de Tutor. Siempre escribe el metadato de video como un array nativo de PHP, evitando el almacenamiento de solo texto de ewpa/update-post-meta que Tutor no puede volver a leer. Requiere la capacidad edit_post sobre la lección."

#: includes/abilities.php:8049
msgid "Video source type (e.g. html5, external_url, youtube, vimeo, embedded, shortcode, or a third-party source registered via the tutor_preferred_video_sources filter, such as bunnynet)."
msgstr "Tipo de fuente del video (por ejemplo, html5, external_url, youtube, vimeo, embedded, shortcode, o una fuente de terceros registrada mediante el filtro tutor_preferred_video_sources, como bunnynet)."

#: includes/abilities.php:8053
msgid "The value for that source — e.g. the playable URL for external_url/bunnynet, or the video ID for youtube/vimeo."
msgstr "El valor de esa fuente: por ejemplo, la URL reproducible para external_url/bunnynet, o el ID del video para youtube/vimeo."

#: includes/abilities.php:8057
msgid "Video runtime — hours. Default \"0\"."
msgstr "Duración del video: horas. Por defecto \"0\"."

#: includes/abilities.php:8061
msgid "Video runtime — minutes. Default \"0\"."
msgstr "Duración del video: minutos. Por defecto \"0\"."

#: includes/abilities.php:8065
msgid "Video runtime — seconds. Default \"0\"."
msgstr "Duración del video: segundos. Por defecto \"0\"."
