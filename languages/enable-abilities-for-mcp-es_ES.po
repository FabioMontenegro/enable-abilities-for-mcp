#. Description of the plugin
#: enable-abilities-for-mcp.php
msgid "Connect Claude, ChatGPT & any MCP client to WordPress. 114 abilities: content, SEO, WooCommerce, FSE, LMS & more. Free & self-hosted."
msgstr "Conecta Claude, ChatGPT y cualquier cliente MCP a WordPress. 114 capacidades: contenido, SEO, WooCommerce, FSE, LMS y más. Gratis y autoalojado."

#: enable-abilities-for-mcp.php:1331
#: includes/upload-links.php:682
msgid "Create Upload Link"
msgstr "Crear enlace de subida"

#: enable-abilities-for-mcp.php:1332
msgid "Create a temporary, single-use link to upload an image from the user's computer straight to the media library, without passing the file through the conversation. Images only. Opt-in required."
msgstr "Crea un enlace temporal de un solo uso para subir una imagen desde el computador del usuario directamente a la biblioteca de medios, sin que el archivo pase por la conversación. Solo imágenes. Requiere activación manual."

#: enable-abilities-for-mcp.php:1336
#: includes/upload-links.php:731
msgid "Get Upload Status"
msgstr "Consultar estado de subida"

#: enable-abilities-for-mcp.php:1337
msgid "Check whether the file for an upload link has arrived and get its attachment ID. Opt-in required."
msgstr "Comprueba si ya llegó el archivo de un enlace de subida y obtiene el ID del adjunto. Requiere activación manual."

#: includes/upload-links.php:584
msgid "Uploading…"
msgstr "Subiendo…"

#: includes/upload-links.php:585
msgid "Uploaded. You can close this page and go back to your AI assistant."
msgstr "Imagen subida. Puedes cerrar esta página y volver a tu asistente de IA."

#: includes/upload-links.php:586
msgid "This file is larger than the upload limit."
msgstr "Este archivo supera el límite de subida."

#: includes/upload-links.php:587
msgid "The upload failed:"
msgstr "La subida falló:"

#. translators: %s: site name
#: includes/upload-links.php:596
#: includes/upload-links.php:621
#, php-format
msgid "Upload an image to %s"
msgstr "Sube una imagen a %s"

#: includes/upload-links.php:618
msgid "This upload link has expired"
msgstr "Este enlace de subida ya no es válido"

#: includes/upload-links.php:619
msgid "Links work once and only for a few minutes. Ask your AI assistant for a new one."
msgstr "Cada enlace funciona una sola vez y solo durante unos minutos. Pide uno nuevo a tu asistente de IA."

#. translators: %s: maximum file size, e.g. "8 MB"
#: includes/upload-links.php:622
#, php-format
msgid "JPEG, PNG, GIF, WebP or AVIF, up to %s. The image goes straight to the media library."
msgstr "JPEG, PNG, GIF, WebP o AVIF, hasta %s. La imagen va directo a la biblioteca de medios."

#. translators: %s: maximum file size, e.g. "8 MB"
#: includes/upload-links.php:623
msgid "Drop an image here or click to choose one"
msgstr "Arrastra una imagen aquí o haz clic para elegirla"

#: includes/upload-links.php:683
msgid "Creates a temporary, single-use link to upload an image from the user's computer straight to the media library, so the file never passes through the conversation. Use this instead of sending base64. If you can run commands and have the file, send it with an HTTP PUT to upload_url; otherwise, or if that request fails, give the user page_url to open in a browser. Then call ewpa/get-upload-status with upload_id to get the attachment ID."
msgstr "Crea un enlace temporal de un solo uso para subir una imagen desde el computador del usuario directamente a la biblioteca de medios, sin que el archivo pase por la conversación. Úsalo en lugar de enviar base64. Si puedes ejecutar comandos y tienes el archivo, envíalo con un HTTP PUT a upload_url; si no, o si esa petición falla, dale al usuario page_url para que lo abra en un navegador. Luego llama a ewpa/get-upload-status con upload_id para obtener el ID del adjunto."

#: includes/upload-links.php:732
msgid "Reports whether the file for an upload link has arrived. Returns status \"pending\", \"completed\" (with the attachment ID and URL) or \"expired\"."
msgstr "Indica si ya llegó el archivo de un enlace de subida. Devuelve el estado \"pending\", \"completed\" (con el ID y la URL del adjunto) o \"expired\"."
